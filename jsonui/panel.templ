package jsonui

import (
	popui "github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

// panelRoot wraps a panel's template in an Alpine.js component using
// the panel data as its x-data, and init as its x-init when set.
// `display: contents` keeps the wrapper out of the layout. Panels with
// fields have jsonui.js track their errors, validating the data against
// schemas when there are any.
templ panelRoot(xdata, init string, errors bool, schemas string) {
	<div
		data-popui-panel
		class="contents"
		x-data={ xdata }
		if init != "" {
			x-init={ init }
		}
		if errors {
			x-jsonui-errors={ schemas }
		}
	>
		{ children... }
	</div>
}

// field wraps a form control with the error shown for the data path it's
// the model of. It's hidden until Alpine shows it, in a live region so
// screen readers announce it, and has an id unique to the field that the
// control is described by while it's shown.
templ field(path, shown string) {
	<div data-jsonui-field={ path } x-id={ "['" + errorIDName + "']" }>
		{ children... }
		<div aria-live="polite">
			@popui.InputError(props.Error{Class: "mt-2", Attributes: templ.Attributes{"style": "display: none", "x-show": shown, xText: shown, ":id": errorID}})
		</div>
	</div>
}

// unplacedErrors lists the errors shown for paths without a field, such as
// the whole of the data a schema validates, in a live region so screen
// readers announce them.
templ unplacedErrors() {
	<div aria-live="polite">
		<template x-for="e in $errors.unplaced()" :key="e.path">
			@popui.InputError(props.Error{Class: "mt-2", Attributes: templ.Attributes{xText: "e.message"}})
		</template>
	</div>
}

// boundText renders text whose content is kept in sync with an Alpine
// expression.
templ boundText(text, bind string) {
	<span x-text={ bind }>{ text }</span>
}

// loopTemplate repeats its children for every item of an Alpine x-for
// expression.
templ loopTemplate(expr string) {
	<template x-for={ expr }>
		{ children... }
	</template>
}

// ifTemplate renders its children while an Alpine expression is true.
templ ifTemplate(cond string) {
	<template x-if={ cond }>
		{ children... }
	</template>
}

// option renders a select option.
templ option(o Option) {
	<option
		value={ o.Value }
		if o.Disabled {
			disabled
		}
		if o.Selected {
			selected
		}
		{ o.Attributes... }
	>{ o.Label }</option>
}

// unavailable renders the option showing a select's model when none of the
// options has its value.
templ unavailable(model, label string) {
	<option :value={ model } x-text={ label } :selected="true" selected disabled></option>
}

// plainText renders text as an element, for templates that need one.
templ plainText(text string) {
	<span>{ text }</span>
}

