package examples

import (
	"github.com/invopop/icons"
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ ButtonSplitIconsExample() {
	@popui.ButtonGroup() {
		@popui.SplitButton(props.SplitButton{
			Label:  "New invoice",
			Icon:   icons.Add(),
			Button: props.Button{Variant: props.ButtonVariantPrimary},
		}) {
			@popui.MenuItem() {
				New credit note
			}
			@popui.MenuItem() {
				New receipt
			}
		}
		@popui.SplitButton(props.SplitButton{
			Label: "Download",
			Icon:  icons.Download(),
		}) {
			@popui.MenuItem() {
				Download as PDF
			}
			@popui.MenuItem() {
				Download as CSV
			}
		}
	}
}
