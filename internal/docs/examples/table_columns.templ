package examples

import (
	"fmt"
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

type tableColumnsInvoice struct {
	Series, Code, Date, Customer, TaxID, State, Total string
}

var tableColumnsInvoices = []tableColumnsInvoice{
	{"SAMPLE", "0001", "2026-10-01", "Provide One S.L.", "ESB98602642", "Sent", "1,210.00 €"},
	{"SAMPLE", "0002", "2026-10-03", "Sample Consumer Goods and Services Ltd.", "GB350983637", "Paid", "84.70 €"},
	{"SAMPLE", "0003", "2026-10-07", "Acme Corporation", "DE111111125", "Draft", "15,000.00 €"},
	{"CN", "0001", "2026-10-09", "Provide One S.L.", "ESB98602642", "Sent", "-121.00 €"},
	{"SAMPLE", "0004", "2026-10-12", "Globex Industries", "FR40303265045", "Error", "3,025.50 €"},
	{"SAMPLE", "0005", "2026-10-15", "Initech", "NL859191127B01", "Paid", "999.99 €"},
	{"SAMPLE", "0006", "2026-10-18", "Umbrella Partners", "IT12345670017", "Sent", "42.00 €"},
	{"SAMPLE", "0007", "2026-10-21", "Hooli Europe", "IE6388047V", "Paid", "7,560.00 €"},
}

// Sorting is done by the server: each sort item carries the attributes
// that reload the table sorted, typically hx-get and friends, e.g.
//
//	templ.Attributes{"hx-get": "/invoices?sort=code", "hx-target": "#invoices", "hx-swap": "outerHTML"}
//
// This page has no server, so they're inert here.
func tableColumnsSort(field, dir string) templ.Attributes {
	return templ.Attributes{"data-sort": fmt.Sprintf("%s %s", field, dir)}
}

templ TableColumnsExample() {
	<div
		class="flex flex-col gap-2"
		x-data="{ event: '' }"
		x-on:popui-table-column-resize="event = `resize ${$event.detail.key}: ${$event.detail.width}px`"
		x-on:popui-table-columns-freeze="event = `frozen: ${$event.detail.frozen.join(', ') || 'none'}`"
	>
		@popui.Table(props.Table{
			ID:           "invoices",
			RootClass:    "max-h-80 overflow-auto",
			StickyHeader: true,
			Resizable:    true,
			Freezable:    true,
			Columns: []props.TableColumn{
				{Key: "series", Title: "Series", Width: 90, MinWidth: 60, Frozen: true},
				{
					Key: "code", Title: "Code", Width: 120, MinWidth: 80, Frozen: true,
					Sort:           "asc",
					SortAscending:  tableColumnsSort("code", "asc"),
					SortDescending: tableColumnsSort("code", "desc"),
				},
				{
					Key: "date", Title: "Issue Date", Width: 140, MinWidth: 120,
					SortAscending:  tableColumnsSort("date", "asc"),
					SortDescending: tableColumnsSort("date", "desc"),
				},
				{Key: "customer", Title: "Customer", Width: 200, MinWidth: 150},
				{Key: "tax_id", Title: "Tax ID", Width: 160, MinWidth: 100},
				{Key: "state", Title: "State", Width: 120, MinWidth: 100},
				{Key: "total", Title: "Total", Width: 150, MinWidth: 100, Align: props.TableColumnAlignRight},
			},
		}) {
			<tbody>
				for _, inv := range tableColumnsInvoices {
					<tr>
						<td>{ inv.Series }</td>
						<td><span class="font-mono">{ inv.Code }</span></td>
						<td>{ inv.Date }</td>
						<td>{ inv.Customer }</td>
						<td><span class="font-mono">{ inv.TaxID }</span></td>
						<td>{ inv.State }</td>
						<td><span class="font-mono">{ inv.Total }</span></td>
					</tr>
				}
			</tbody>
		}
		<p class="text-sm text-foreground-default-secondary h-4" x-text="event"></p>
	</div>
}
