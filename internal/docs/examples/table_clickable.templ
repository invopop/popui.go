package examples

import (
	"github.com/invopop/popui.go"
)

templ TableClickableExample() {
	@popui.Table() {
		<thead>
			<tr>
				<th>Product</th>
				<th>Status</th>
				<th>Price</th>
			</tr>
		</thead>
		<tbody>
			<tr onclick="alert('Widget A')">
				<td>Widget A</td>
				<td>Available</td>
				<td>$29.99</td>
			</tr>
			<tr onclick="alert('Widget B')">
				<td>Widget B</td>
				<td>Out of Stock</td>
				<td>$39.99</td>
			</tr>
			// Rows whose listener is attached programmatically opt in
			// with data-clickable to get the same pointer cursor.
			<tr data-clickable>
				<td>Widget C</td>
				<td>Available</td>
				<td>$49.99</td>
			</tr>
		</tbody>
	}
}
