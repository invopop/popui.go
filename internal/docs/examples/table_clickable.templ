package examples

import (
	"github.com/invopop/popui.go"
)

templ TableClickableExample() {
	@popui.Table() {
		<thead>
			<tr>
				<th>Product</th>
				<th>Status</th>
				<th>Price</th>
			</tr>
		</thead>
		<tbody>
			// The row handles the click; the button in the first cell gives
			// keyboard and screen reader users a real control. Enter or Space
			// on it fires a click that bubbles up to the row's handler.
			<tr onclick="alert('Widget A')">
				<td><button type="button" class="text-left">Widget A</button></td>
				<td>Available</td>
				<td>$29.99</td>
			</tr>
			<tr onclick="alert('Widget B')">
				<td><button type="button" class="text-left">Widget B</button></td>
				<td>Out of Stock</td>
				<td>$39.99</td>
			</tr>
			// Rows whose listener is attached programmatically opt in
			// with data-clickable to get the same pointer cursor.
			<tr id="popui-clickable-row" data-clickable>
				<td><button type="button" class="text-left">Widget C</button></td>
				<td>Available</td>
				<td>$49.99</td>
			</tr>
		</tbody>
	}
	<script>
		document.getElementById("popui-clickable-row").addEventListener("click", function() { alert("Widget C"); });
	</script>
}
