package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ TooltipCodeExample() {
	<div class="flex justify-center pt-8 pb-80">
		@popui.Tooltip(props.Tooltip{
			Title:    "HMAC secret",
			Position: props.TooltipPositionBottomStart,
			Class:    "w-80 max-w-80",
			Description: "When set, each request carries an `X-Webhook-Signature` header: " +
				"`sha256=` followed by the HMAC-SHA256 hex digest of the request body.\n\n" +
				"Verify it with the same secret:\n\n" +
				"```\n" +
				"hmac.New(sha256.New, secret)\n" +
				"```",
		}) {
			@popui.Button() {
				Hover me
			}
		}
	</div>
}
