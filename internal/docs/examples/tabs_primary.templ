package examples

import (
	"github.com/invopop/icons"
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ TabsPrimaryExample() {
	<div class="w-full rounded-lg border border-border bg-background pt-3 overflow-hidden">
		@popui.Tabs(props.Tabs{Variant: "primary", Active: "document", Tabs: []props.TabItem{
			{Value: "overview", Label: "Overview"},
			{Value: "document", Label: "Document"},
			{Value: "files", Label: "Files", Count: 2},
			{Value: "add", Title: "Add a tab", Icon: icons.Add()},
		}}) {
			@popui.Tab(props.Tab{Value: "overview", Class: "p-4"}) {
				<p class="text-base text-foreground-default-secondary">The overview of the page.</p>
			}
			@popui.Tab(props.Tab{Value: "document", Class: "p-4"}) {
				<p class="text-base text-foreground-default-secondary">The document.</p>
			}
			@popui.Tab(props.Tab{Value: "files", Class: "p-4"}) {
				<p class="text-base text-foreground-default-secondary">Its files.</p>
			}
			@popui.Tab(props.Tab{Value: "add", Class: "p-4"}) {
				<p class="text-base text-foreground-default-secondary">Something new.</p>
			}
		}
	</div>
}
