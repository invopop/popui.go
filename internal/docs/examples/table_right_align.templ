package examples

import "github.com/invopop/popui.go"

templ TableRightAlignExample() {
	@popui.Table() {
		<thead>
			<tr>
				<th>Item</th>
				<th data-numeric data-align="end">Quantity</th>
				<th data-numeric data-align="end">Amount</th>
			</tr>
		</thead>
		<tbody>
			<tr>
				<td>Product A</td>
				<td data-numeric data-align="end">3</td>
				<td data-numeric data-align="end">$89.97</td>
			</tr>
			<tr>
				<td>Product B</td>
				<td data-numeric data-align="end">1</td>
				<td data-numeric data-align="end">$39.99</td>
			</tr>
			<tr>
				<td>Product C</td>
				<td data-numeric data-align="end">2</td>
				<td data-numeric data-align="end">$99.98</td>
			</tr>
		</tbody>
	}
}
