package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ AccordionGroupExample() {
	@popui.AccordionGroup() {
		@popui.Accordion(props.Accordion{Title: "Getting started"}) {
			@popui.Description() {
				Install the package and render your first component.
			}
		}
		@popui.Accordion(props.Accordion{Title: "Advanced features"}) {
			@popui.Description() {
				Compose accordions with any other PopUI component as content.
			}
		}
		@popui.Accordion(props.Accordion{Title: "Troubleshooting"}) {
			@popui.Description() {
				Check the API reference below for every available prop.
			}
		}
	}
}
