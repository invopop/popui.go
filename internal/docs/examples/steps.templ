package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ StepsExample() {
	<div class="w-70">
		@popui.Steps(props.Steps{Label: "Progress"}) {
			@popui.Step(props.Step{Label: "Review and complete the details", Status: props.StepStatusCompleted})
			@popui.Step(props.Step{Label: "Download and sign the agreement", Status: props.StepStatusCurrent}) {
				@popui.SubStep(props.SubStep{Label: "Proof of legal representation", Current: true})
				@popui.SubStep(props.SubStep{Label: "Identity document"})
			}
		}
	</div>
}
