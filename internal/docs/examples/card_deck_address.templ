package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ CardDeckAddressExample() {
	@popui.CardDeck() {
		@popui.CardDeckHead() {
			<span>Address</span>
			@popui.Button(props.Button{Size: "sm"}) {
				Manage
			}
		}
		@popui.Card(props.Card{Class: "p-3"}) {
			@popui.Details(props.Details{Layout: props.DetailsLayoutStacked, Class: "space-y-3"}) {
				@popui.Detail(props.Detail{
					Label: "Company legal name",
					Value: "Invopop S.L. Billing",
				})
				@popui.Detail(props.Detail{
					Label: "Billing email",
					Value: "juan@invopop.com",
				})
				@popui.Detail(props.Detail{Label: "Address"}) {
					<span class="flex flex-col">
						<span>Calle Pradillo 42, Madrid</span>
						<span>Madrid, 28002, ES</span>
					</span>
				}
				@popui.Detail(props.Detail{
					Label: "Tax ID",
					Value: "ESX3157928M",
				})
			}
		}
	}
}
