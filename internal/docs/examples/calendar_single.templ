package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ CalendarSingleExample() {
	<div
		x-data="{ show: false }"
		@click.outside="if (show) Alpine.$data($refs.panel.firstElementChild).cancel()"
		@popui-cal-confirm="show = false"
		@popui-cal-cancel="show = false"
		class="w-fit"
	>
		@popui.Button(props.Button{
			Attributes: templ.Attributes{
				"@click": "show = !show",
			},
		}) {
			Pick a date
		}
		<div x-show="show" x-cloak x-ref="panel" class="mt-2">
			@popui.Calendar(props.Calendar{
				Name:   "due_date",
				Single: true,
			})
		</div>
	</div>
}
