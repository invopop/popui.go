package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ GridExample() {
	@popui.Card(props.Card{Class: "p-0 gap-0 max-w-[746px]"}) {
		<div class="px-4 py-3 border-b border-border">
			@popui.Title() {
				FR1-000184
			}
		</div>
		@popui.Grid(props.Grid{Columns: 2}) {
			@popui.Cell(props.GridCell{Rows: 2, Borders: []props.Border{{Edge: props.EdgeRight, Style: props.BorderDashed}}}) {
				@popui.Title(props.Title{Size: "base"}) {
					Document
				}
				@popui.Details() {
					@popui.Detail(props.Detail{Label: "Issue date", Value: "2025-06-10"})
					@popui.Detail(props.Detail{Label: "Due date", Value: "2025-06-20"})
					@popui.Detail(props.Detail{Label: "Currency", Value: "Euro (EUR)"})
					@popui.Detail(props.Detail{Label: "Purchase order", Value: "PO-7802"})
				}
			}
			@popui.Cell(props.GridCell{Borders: []props.Border{{Edge: props.EdgeBottom, Style: props.BorderDashed}}}) {
				@popui.Title(props.Title{Size: "base"}) {
					Supplier
				}
				@popui.Details() {
					@popui.Detail(props.Detail{Label: "Name", Value: "Invopop SL"})
					@popui.Detail(props.Detail{Label: "Tax code", Value: "74 912345678"})
				}
			}
			@popui.Cell() {
				@popui.Title(props.Title{Size: "base"}) {
					Customer
				}
				@popui.Details() {
					@popui.Detail(props.Detail{Label: "Name", Value: "Nordvent SA"})
					@popui.Detail(props.Detail{Label: "Tax code", Value: "74 746374638"})
				}
			}
			@popui.Cell(props.GridCell{Span: 2, Borders: []props.Border{{Edge: props.EdgeTop}}}) {
				@popui.Stats(props.Stats{Align: props.AlignEnd}) {
					@popui.Stat(props.Stat{Label: "Total payable", Value: "€8,820.93", Size: props.StatSizeLarge})
					@popui.Stat(props.Stat{Label: "Net amount", Value: "€7,366.00"})
					@popui.Stat(props.Stat{Label: "VAT", Value: "€1,454.93"})
				}
			}
		}
	}
}
