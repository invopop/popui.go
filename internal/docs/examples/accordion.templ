package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ AccordionExample() {
	<div class="w-full space-y-3">
		@popui.Accordion(props.Accordion{Title: "I am an Accordion.", Open: true}) {
			@popui.Description() {
				You can put any content in here, including other components.
			}
		}
		@popui.Accordion(props.Accordion{Title: "I am an Accordion with a much longer title that keeps going so you can see how it wraps onto a second line."}) {
			@popui.Description() {
				Long titles wrap while the caret stays pinned to the right edge.
			}
		}
	</div>
}
