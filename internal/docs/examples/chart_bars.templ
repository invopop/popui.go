package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ ChartBarsExample() {
	<div class="grid grid-cols-1 sm:grid-cols-2 gap-8 w-full">
		@popui.BarList(props.BarList{
			Label: "Documents by type",
			Bars: []props.ChartValue{
				{Label: "Invoices", Value: 1284, Href: "#"},
				{Label: "Payments", Value: 431, Href: "#"},
				{Label: "Parties", Value: 96, Href: "#"},
				{Label: "Orders", Value: 12, Href: "#"},
			},
		})
		@popui.SegmentedBar(props.SegmentedBar{
			Label: "Invoices by state",
			Parts: []props.ChartValue{
				{Label: "Sent", Value: 802, Color: "blue", Href: "#"},
				{Label: "Paid", Value: 341, Color: "green", Href: "#"},
				{Label: "Draft", Value: 98, Color: "orange", Href: "#"},
				{Label: "Error", Value: 31, Color: "red", Href: "#"},
				{Label: "Rejected", Value: 12, Color: "crimson", Href: "#"},
			},
		})
	</div>
}
