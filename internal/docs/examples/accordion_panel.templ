package examples

import (
	"github.com/invopop/icons"
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ AccordionPanelExample() {
	<div class="flex w-full max-w-md flex-col gap-4">
		@popui.Accordion(props.Accordion{Variant: "panel", Title: "Silo", Icon: icons.View(), Open: true, Actions: accordionPanelEdit()}) {
			@popui.Details() {
				@popui.Detail(props.Detail{Label: "Type", Value: "Standard"})
				@popui.Detail(props.Detail{Label: "Issue date", Value: "2023-08-01"})
				@popui.Detail(props.Detail{Label: "Total", Value: "45913.08 EUR"})
			}
		}
		@popui.Accordion(props.Accordion{Variant: "panel", Title: "Jobs", Icon: icons.History()}) {
			<p class="text-base text-foreground-default-secondary">No jobs yet.</p>
		}
	</div>
}

templ accordionPanelEdit() {
	@popui.Button(props.Button{Variant: props.ButtonVariantTransparent, Size: props.ButtonSizeIconSmall, Attributes: templ.Attributes{"type": "button", "aria-label": "Edit"}}) {
		@icons.Edit()
	}
}
