package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ DetailsWrappingExample() {
	<div class="w-[360px]">
		@popui.Details() {
			@popui.Detail(props.Detail{Label: "Name", Value: "Acme Corporation"})
			@popui.Detail(props.Detail{Label: "Address", Value: "Calle de Alcalá 123, 4º Izquierda, 28009 Madrid, Spain"})
			@popui.Detail(props.Detail{
				Label: "Notes",
				Value: "Invoices are sent on the first working day of each month and are payable within 30 days by bank transfer.",
			})
			@popui.Detail(props.Detail{Label: "Email", Value: "billing@acme.example"})
		}
	</div>
}
