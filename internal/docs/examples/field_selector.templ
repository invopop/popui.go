package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/goblfields"
	"github.com/invopop/popui.go/props"
)

// The tree is built once: it only changes when the GOBL dependency does.
var invoiceFields = goblfields.MustBuild("bill/invoice")

templ FieldSelectorExample() {
	@popui.FieldSelector(props.FieldSelector{
		Name:   "field",
		Root:   "bill/invoice",
		Fields: invoiceFields,
	})
}
