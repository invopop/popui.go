package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ InputDatesExample() {
	@popui.Input(props.Input{
		Name:  "starts_at",
		Type:  "datetime-local",
		Label: "Starts at",
		Value: "2026-09-20T12:30:00Z",
	})
	@popui.Input(props.Input{
		Name:  "issue_date",
		Type:  "date",
		Label: "Issue date",
		Value: "2026-09-20",
	})
	@popui.Input(props.Input{
		Name:  "cutoff",
		Type:  "time",
		Label: "Cut-off time",
		Value: "17:30",
	})
}
