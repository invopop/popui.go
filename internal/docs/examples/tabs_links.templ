package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ TabsLinksExample() {
	@popui.Tabs(props.Tabs{Active: "tabs", Tabs: []props.TabItem{
		{Value: "tabs", Label: "Tabs", Href: "/components/tabs/"},
		{Value: "card", Label: "Card", Href: "/components/card/"},
		{Value: "accordion", Label: "Accordion", Href: "/components/accordion/"},
	}})
}
