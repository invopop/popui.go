package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ ButtonSplitExample() {
	@popui.ButtonGroup() {
		@popui.SplitButton(props.SplitButton{
			Label:  "Save",
			Button: props.Button{Variant: props.ButtonVariantPrimary},
		}) {
			@popui.MenuItem() {
				Save and close
			}
			@popui.MenuItem() {
				Save as draft
			}
			@popui.MenuItem() {
				Save as template
			}
		}
		@popui.SplitButton(props.SplitButton{
			Label: "Export",
		}) {
			@popui.MenuItem() {
				Export as PDF
			}
			@popui.MenuItem() {
				Export as CSV
			}
		}
		@popui.SplitButton(props.SplitButton{
			Label:  "Duplicate",
			Button: props.Button{Variant: props.ButtonVariantSecondary},
		}) {
			@popui.MenuItem() {
				Duplicate with edits
			}
			@popui.MenuItem() {
				Duplicate as draft
			}
		}
	}
}
