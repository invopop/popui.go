package examples

import (
	"github.com/invopop/icons"
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/goblfields"
	"github.com/invopop/popui.go/props"
)

var envelopeFields = goblfields.MustBuild("envelope", goblfields.Options{Descriptions: true})

// Whatever is in the children slot is the trigger. A read-only Input bound
// to the value makes the picker behave like a select: the field shows the
// pick, and a Value set up front is where the panel opens.
templ FieldPickerCustomTriggerExample() {
	@popui.FieldPicker(props.FieldPicker{
		Label:  "Envelope field",
		Name:   "field",
		Root:   "envelope",
		Value:  "head.stamps[].val",
		Fields: envelopeFields,
	}) {
		@popui.Input(props.Input{
			Placeholder: "Select a field",
			Icon:        icons.Brackets(),
			Class:       "font-mono cursor-pointer",
			Attributes: templ.Attributes{
				":value":   "value",
				"readonly": true,
			},
		})
	}
}
