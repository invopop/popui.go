package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

// A page that serves every workflow is rendered with a group per schema,
// and learns which schema the workflow carries only once it is running.
// The picker's scope is set from that: the group's fields then stand at the
// root, under the group's name, and their paths read from there — the
// variables first, the document beneath. Here a select stands in for the
// workflow; the x-effect carries its choice into each picker.
templ FieldPickerScopeExample() {
	<div x-data="{ schema: 'Invoice' }" class="flex flex-col gap-4 w-full">
		@popui.Select(props.Select{
			Label: "Workflow schema",
			Attributes: templ.Attributes{
				"x-model": "schema",
			},
		}) {
			<option value="Invoice">Invoice</option>
			<option value="Delivery">Delivery</option>
			<option value="">Not known yet</option>
		}
		@popui.Contenteditable(props.Textarea{
			ID:             "scoped-message",
			Name:           "message",
			Label:          "Message",
			Rows:           3,
			Value:          slackMessage,
			VariableFormat: "{{.%s}}",
			Picker: &props.FieldPicker{
				Root:        "Schemas",
				Scope:       "Invoice",
				Fields:      slackFields,
				Format:      "{{.%s}}",
				ScalarsOnly: true,
				Attributes: templ.Attributes{
					"x-effect": "scope = schema",
				},
			},
		})
	</div>
}
