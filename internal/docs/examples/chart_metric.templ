package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ ChartMetricExample() {
	<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 w-full">
		@popui.Metric(props.Metric{
			Label:    "Invoices",
			Value:    "1,284",
			Change:   0.12,
			Previous: "previous 30 days",
			Trend:    []float64{32, 41, 38, 45, 52, 48, 61, 58, 66, 71, 69, 80},
			Href:     "#",
		})
		@popui.Metric(props.Metric{
			Label:     "Failed jobs",
			Value:     "37",
			Note:      "2.9% of jobs",
			Change:    0.08,
			Direction: props.MetricUpBad,
			Previous:  "previous 30 days",
			Trend:     []float64{2, 4, 1, 3, 3, 5, 2, 4, 6, 3, 2, 2},
		})
		@popui.Metric(props.Metric{
			Label:    "Payments",
			Value:    "12",
			Previous: "previous 30 days",
			NoChange: true,
		})
	</div>
}
