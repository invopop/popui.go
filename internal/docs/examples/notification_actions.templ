package examples

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

templ NotificationActionsExample() {
	@popui.Notification(props.Notification{
		Type:        "neutral",
		Text:        "Verify your billing details",
		Description: "We need a valid tax ID before you can send invoices.",
		Actions:     notificationActions(),
	})
}

templ notificationActions() {
	@popui.Button(props.Button{Variant: props.ButtonVariantTransparent}) {
		Dismiss
	}
	// The default bordered variant reads against the neutral notification;
	// the secondary variant shares its bg-background-default-tertiary tint.
	@popui.Button() {
		Add tax ID
	}
}
