package examples

import (
	"github.com/invopop/icons"
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
)

// CalendarSingleInputExample pairs one text input holding an ISO 8601
// timestamp with a single-date calendar behind one button. Confirming a day
// replaces the leading YYYY-MM-DD of the field and keeps the rest of the
// string (time and zone) as typed. The calendar floats below the field so
// opening it never shifts the surrounding layout.
templ CalendarSingleInputExample() {
	<div
		x-data="{ show: false, setDate(input, iso) { const rest = input.value.slice(10) || 'T12:00:00Z'; input.value = iso ? iso + rest : '' } }"
		@click.outside="if (show) Alpine.$data($refs.panel.firstElementChild).cancel()"
		@popui-cal-cancel="show = false"
		@popui-cal-confirm="show = false; setDate($refs.due, Alpine.$data($event.target).committedFrom)"
		class="relative w-fit"
	>
		<div class="flex items-end gap-3">
			@popui.Input(props.Input{
				Type:       "text",
				Class:      "w-64",
				Label:      "Due",
				Name:       "due",
				Value:      "2026-09-17T09:00:00Z",
				Attributes: templ.Attributes{"x-ref": "due"},
			})
			@popui.Button(props.Button{
				Size:       props.ButtonSizeIconLarge,
				Attributes: templ.Attributes{"type": "button", "@click": "show = !show", "aria-label": "Pick date"},
			}) {
				@icons.Calendar()
			}
		</div>
		<div x-show="show" x-cloak x-ref="panel" class="absolute left-0 top-full mt-2 z-10">
			@popui.Calendar(props.Calendar{
				Name:   "due_date",
				Single: true,
				From:   "2026-09-17",
			})
		</div>
	</div>
}
