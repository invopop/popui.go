package docs

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/internal/docs/modules"
	"github.com/invopop/popui.go/internal/docs/playground"
	"github.com/invopop/popui.go/jsonui"
	"github.com/invopop/popui.go/jsonui/schema"
	"github.com/invopop/popui.go/props"
	"strings"
)

templ jsonUI() {
	@article("json-ui", "JSON UI", "Describe panels of PopUI components in JSON and render them in Go or in the browser. Experimental.") {
		@popui.Description() {
			The jsonui package renders PopUI components from a panel described in JSON instead of templ code, so an app can send a form or a detail view as data. A panel is part of a page rather than a whole page: the host places it wherever it fits, and it carries its own data, handlers and validation. The same Go renderer runs on the server or, compiled to WebAssembly, in the browser, and a JSON Schema gives editors completion and validation. Panels hold no code: behaviour comes from named actions that the host page implements and allows.
		}
		@popui.ButtonGroup() {
			@popui.Button(props.Button{Href: templ.SafeURL(playground.Path), Target: "_blank"}) {
				Open the playground
			}
		}
		@modules.Example(modules.ExampleProps{
			Title:       "Data and bind",
			Description: "A panel lists the components to render, each named with \"is\" after HTML's global is attribute. \"props\" are the component's props from the props package, and \"bind\" fills props from the panel's \"data\" when it is rendered.",
			Code:        jsonuiDetailsExample,
			Language:    "json",
		}) {
			@jsonuiRender(jsonuiDetailsExample)
		}
		@modules.Example(modules.ExampleProps{
			Title:       "Forms and actions",
			Description: "\"model\" binds a form control to the data both ways, \"bind\" on a text node keeps it in sync, and \"on\" runs actions for DOM events, inline or by the name of one of the panel's handlers. Edit the fields, then save or reset.",
			Code:        jsonuiFormExample,
			Language:    "json",
		}) {
			@jsonuiRender(jsonuiFormExample)
		}
		@modules.Section("Panel", "json-ui-panel") {
			@modules.APITable(modules.APITableProps{
				Items: []modules.APITableItem{
					{Name: "components", Type: "[]node", Required: true, Description: "The components to render, in order."},
					{Name: "data", Type: "object", Description: "The panel's state. It becomes the Alpine.js `x-data` of the panel, is where `bind` and `model` read from, and is what actions change."},
					{Name: "handlers", Type: "object", Description: "Named actions, or lists of actions, that `on` can refer to by name, so a handler used in several places is defined once."},
					{Name: "schemas", Type: "object", Description: "Data paths mapped to the JSON Schema their value must match, e.g. `{\"config\": {...}}`. See Validation below."},
					{Name: "init", Type: "handler", Description: "Runs once when the panel starts, like an `on` handler: an action, a handler name or a list of them, e.g. `\"update\"` so the host receives the initial data."},
					{Name: "$schema", Type: "string", Description: "The JSON Schema of the format, for editors. Ignored when rendering."},
				},
			})
		}
		@modules.Section("Nodes", "json-ui-nodes") {
			@modules.APITable(modules.APITableProps{
				Items: []modules.APITableItem{
					{Name: "is", Type: "string", Required: true, Description: "The component to render, from the list below, or `text` for plain text."},
					{Name: "props", Type: "object", Description: "The component's props, as in the props package. Field names match case-insensitively and unknown fields are errors."},
					{Name: "children", Type: "[]node", Description: "Nodes rendered inside the component."},
					{Name: "bind", Type: "object", Description: "Prop names mapped to data paths, e.g. `{\"title\": \"invoice.code\"}`, resolved when rendering. Some props also follow the data as it changes, such as `disabled` on form controls and buttons other than multiple selects, and an option's `value`, `label` and `disabled`. On a `text` node, a single data path whose value is shown and kept up to date."},
					{Name: "each", Type: "string", Description: "Data path of a list to repeat the node for, following the list as it changes, e.g. when an action stores a fetched list with `into`. The node and its children refer to the current item as `item` and its position as `index`, in `bind`, `model` and `show`. The node must render a single element, such as a table row or list item. A list's `length` is also a data path, e.g. `\"show\": \"!rows.length\"` for a row saying the list is empty."},
					{Name: "show", Type: "string | object", Description: "Renders the node only while a condition holds: a data path, true when its value is, optionally negated with `!`, e.g. `\"!config.sandbox\"`, or data paths mapped to the values each may have, all of which must match, e.g. `{\"workflow.schema\": [\"bill/invoice\"]}`. The node must render a single element."},
					{Name: "model", Type: "string", Description: "Data path a form control reads and writes, e.g. `customer.email`. Its initial value is rendered on the server."},
					{Name: "on", Type: "object", Description: "DOM events, with optional Alpine modifiers such as `submit.prevent` or `input.debounce.300ms`, mapped to an action, a handler name or a list of them."},
					{Name: "text", Type: "string", Description: "The text of a `text` node."},
				},
			})
		}
		@modules.Section("Lists from the host", "json-ui-lists") {
			@popui.Description() {
				A list the host provides, such as one fetched by a host action in init, is stored in the data with `into` and rendered with `each`. A select's options rendered this way keep its model selected however the list and the model change. A saved value missing from the list is kept and shown as unavailable rather than cleared, so nothing changes until the user picks another.
			}
			@modules.CodeBlock(modules.CodeBlockProps{Code: jsonuiListsExample, Language: "json"})
		}
		@modules.Section("Validation", "json-ui-validation") {
			@popui.Description() {
				"schemas" describe what the data must be with JSON Schemas, so a panel can check its data as it's edited and an app can check it again with the same schemas when it's saved. They also tell anyone writing the data without the form, such as an LLM, what it must be.
			}
			<ul class="list-disc pl-5 flex flex-col gap-1 text-foreground-default-secondary">
				<li>Each form control with a "model" shows the error for its path once it's been changed or left, or after the validate action. Errors for paths without a control are shown after the panel.</li>
				<li>Messages are written for the person filling in the form. A schema's "errorMessage" replaces them: one message, or one for each keyword, such as { `{"format": "Enter an email address"}` }; on an object, "required" can have a message for each property.</li>
				<li>Labels, descriptions and select options are defined by component props or bindings. Schema annotations and schema structure do not change the presentation.</li>
				<li>Host actions report errors, such as those from the server saving the data, by throwing an error with an "errors" list of paths and messages. They show on their fields until the field is changed or the action runs again.</li>
				<li>Schemas can only refer to themselves with "$ref". Data is validated in the browser by popui.wasm. Explicit validate actions stop if validation cannot run and show a panel-level error unless silent is true.</li>
			</ul>
			@popui.Description() {
				$errors.checked reports whether the current data has been validated successfully; $errors.valid is true only after a successful check with no schema errors. Both are false while validation is pending or unavailable. Panels without schemas are considered checked and valid.
			}
			@modules.CodeBlock(modules.CodeBlockProps{Code: jsonuiValidationExample, Language: "json"})
			@modules.CodeBlock(modules.CodeBlockProps{Code: jsonuiErrorsExample, Language: "markup"})
		}
		@modules.Section("Components", "json-ui-components") {
			@popui.Description() {
				Each component maps to the PopUI component of the same name, so its props are documented on that component's page. The exceptions are upload_file, option, and the elements that structure tables and lists (thead, tbody, tr, th, td, ul, ol and li), whose props are in the jsonui package.
			}
			@modules.APITable(modules.APITableProps{Items: jsonuiComponentItems()})
		}
		@modules.Section("Actions", "json-ui-actions") {
			@popui.Description() {
				Actions are implemented in jsonui.js, which must be on the page with PopUI's assets and Alpine.js. String params can include data with placeholders such as { `"Hello {{customer.name}}"` }, filled in when the action runs.
			}
			@modules.APITable(modules.APITableProps{
				Title: "Built-in actions",
				Items: []modules.APITableItem{
					{Name: "alert", Type: "message", Description: "Shows `message` in the browser's alert dialog."},
					{Name: "set", Type: "path, value", Description: "Sets the data at `path` to `value`."},
					{Name: "reset", Type: "", Description: "Restores the panel's data to its initial values, and clears its errors."},
					{Name: "validate", Type: "silent", Description: "Validates the data against the panel's schemas and stops the actions after it while there are errors or validation cannot run. Every error is shown, unless `silent` is true, e.g. to only pass valid data to the host as it changes."},
					{Name: "dispatch", Type: "event, detail", Description: "Dispatches a bubbling DOM event named `event`, with `detail` or else a snapshot of the data, for the host page to handle."},
				},
			})
			@modules.APITable(modules.APITableProps{
				Title: "Params for every action",
				Items: []modules.APITableItem{
					{Name: "into", Type: "string", Description: "Data path to store the action's result in. Skipped when the action returns nothing, e.g. a cancelled file picker."},
					{Name: "busy", Type: "string", Description: "Data path that is true while the action runs, e.g. to show a loading state."},
				},
			})
			@popui.Description() {
				Host pages add their own actions with popui.actions.register, and must also allow them when rendering:
			}
			@modules.CodeBlock(modules.CodeBlockProps{Code: jsonuiActionsExample, Language: "markup"})
		}
		@modules.Section("Strict mode", "json-ui-strict") {
			@popui.Description() {
				Panels are untrusted by default, so a panel can't run script on the host page beyond the actions the host allows. Rendering fails with an error when a panel has:
			}
			<ul class="list-disc pl-5 flex flex-col gap-1 text-foreground-default-secondary">
				<li>Alpine directives, event handler attributes or htmx attributes in props or bound values</li>
				<li>URLs that can run script, such as javascript:, in props or bound values</li>
				<li>text binds, "each" lists and "show" conditions that aren't paths in the panel's data</li>
				<li>data paths through __proto__, prototype or constructor</li>
				<li>actions the host hasn't allowed, or unknown handlers</li>
			</ul>
			@modules.APITable(modules.APITableProps{
				Title: "jsonui.Options",
				Items: []modules.APITableItem{
					{Name: "Actions", Type: "[]string", Default: "BuiltinActions", Description: "The actions panels may use. An empty slice allows none."},
					{Name: "Trusted", Type: "bool", Default: "false", Description: "Turns the strict checks off, for panels from a trusted source."},
				},
			})
		}
		@modules.Section("Rendering in Go", "json-ui-go") {
			@modules.CodeBlock(modules.CodeBlockProps{Code: jsonuiGoExample, Language: "go"})
			@popui.Description() {
				The package embeds jsonui.js for apps to serve:
			}
			@modules.CodeBlock(modules.CodeBlockProps{Code: jsonuiAssetsExample, Language: "go"})
			@popui.Description() {
				Apps validate data they receive against a panel's schemas with the same messages:
			}
			@modules.CodeBlock(modules.CodeBlockProps{Code: jsonuiValidatorExample, Language: "go"})
		}
		@modules.Section("Rendering in the browser", "json-ui-browser") {
			@popui.Description() {
				Each release publishes PopUI's assets, jsonui.js and the WebAssembly renderer to { "https://assets.invopop.com/popui/<version>/" }. Load every file from the same version: wasm_exec.js must match the Go that built popui.wasm. The renderer adds popuiRender(json, options), which returns the HTML or an error, and popuiValidate(schemas, data), which jsonui.js validates panels' data with, and dispatches popui:ready once they're available.
			}
			@modules.CodeBlock(modules.CodeBlockProps{Code: jsonuiBrowserExample, Language: "markup"})
		}
		@modules.Section("Editor support", "json-ui-schema") {
			@popui.Description() {
				Set "$schema" to the panel schema, which is generated from the same components and props as the renderer, for completion, documentation on hover and validation in editors such as VS Code. Use the major version's address below, which always holds the latest release's schema and is the schema's "$id". Each release also publishes its own copy as panel.json next to the other assets, and it's embedded in Go as schema.Panel in the jsonui/schema package.
			}
			@modules.CodeBlock(modules.CodeBlockProps{Code: `{ "$schema": "` + schema.ID + `", "components": [] }`, Language: "json"})
		}
	}
}

// jsonuiComponentItems lists the components panels can use, from the
// jsonui registry, so the table can't fall behind the renderer.
func jsonuiComponentItems() []modules.APITableItem {
	items := []modules.APITableItem{
		{Name: "text", Type: "-", Description: "Plain text from `text`, or a data value from `bind`."},
	}
	for _, c := range jsonui.Components() {
		var notes []string
		if c.Model {
			notes = append(notes, "Form control: accepts `model`.")
		}
		if c.Children {
			notes = append(notes, "Takes `children`.")
		}
		if c.Events != nil {
			notes = append(notes, "Events: `"+strings.Join(c.Events, "`, `")+"`.")
		}
		items = append(items, modules.APITableItem{
			Name:        c.Name,
			Type:        c.Props.String(), // props.X, or jsonui.X for nodes of its own
			Description: strings.Join(notes, " "),
		})
	}
	return items
}
