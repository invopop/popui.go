package docs

import (
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/internal/docs/modules"
	"github.com/invopop/popui.go/internal/docs/playground"
	"github.com/invopop/popui.go/jsonui"
	"github.com/invopop/popui.go/props"
	"strings"
)

templ jsonUI() {
	@article("json-ui", "JSON UI", "Describe PopUI interfaces as JSON documents and render them in Go or in the browser. Experimental.") {
		@popui.Description() {
			The jsonui package renders PopUI components from a JSON document instead of templ code, so an app can send a form or a detail view as data. The same Go renderer runs on the server or, compiled to WebAssembly, in the browser, and a JSON Schema gives editors completion and validation. Documents hold no code: behaviour comes from named actions that the host page implements and allows.
		}
		@popui.ButtonGroup() {
			@popui.Button(props.Button{Href: templ.SafeURL(playground.Path), Target: "_blank"}) {
				Open the playground
			}
		}
		@modules.Example(modules.ExampleProps{
			Title:       "Data and bind",
			Description: "A document lists the components to render, each named with \"is\" after HTML's global is attribute. \"props\" are the component's props from the props package, and \"bind\" fills props from the document's \"data\" when it is rendered.",
			Code:        jsonuiDetailsExample,
			Language:    "json",
		}) {
			@jsonuiRender(jsonuiDetailsExample)
		}
		@modules.Example(modules.ExampleProps{
			Title:       "Forms and actions",
			Description: "\"model\" binds a form control to the data both ways, \"bind\" on a text node keeps it in sync, and \"on\" runs actions for DOM events, inline or by the name of one of the document's handlers. Edit the fields, then save or reset.",
			Code:        jsonuiFormExample,
			Language:    "json",
		}) {
			@jsonuiRender(jsonuiFormExample)
		}
		@modules.Section("Document", "json-ui-document") {
			@modules.APITable(modules.APITableProps{
				Items: []modules.APITableItem{
					{Name: "components", Type: "[]node", Required: true, Description: "The components to render, in order."},
					{Name: "data", Type: "object", Description: "The document's state. It becomes the Alpine.js `x-data` of the document, is where `bind` and `model` read from, and is what actions change."},
					{Name: "handlers", Type: "object", Description: "Named actions, or lists of actions, that `on` can refer to by name, so a handler used in several places is defined once."},
					{Name: "init", Type: "handler", Description: "Runs once when the document starts, like an `on` handler: an action, a handler name or a list of them, e.g. `\"update\"` so the host receives the initial data."},
					{Name: "$schema", Type: "string", Description: "The JSON Schema of the format, for editors. Ignored when rendering."},
				},
			})
		}
		@modules.Section("Nodes", "json-ui-nodes") {
			@modules.APITable(modules.APITableProps{
				Items: []modules.APITableItem{
					{Name: "is", Type: "string", Required: true, Description: "The component to render, from the list below, or `text` for plain text."},
					{Name: "props", Type: "object", Description: "The component's props, as in the props package. Field names match case-insensitively and unknown fields are errors."},
					{Name: "children", Type: "[]node", Description: "Nodes rendered inside the component."},
					{Name: "bind", Type: "object", Description: "Prop names mapped to data paths, e.g. `{\"title\": \"invoice.code\"}`. On a `text` node, a single data path whose value is shown and kept up to date."},
					{Name: "model", Type: "string", Description: "Data path a form control reads and writes, e.g. `customer.email`. Its initial value is rendered on the server."},
					{Name: "on", Type: "object", Description: "DOM events, with optional Alpine modifiers such as `submit.prevent` or `input.debounce.300ms`, mapped to an action, a handler name or a list of them."},
					{Name: "text", Type: "string", Description: "The text of a `text` node."},
				},
			})
		}
		@modules.Section("Components", "json-ui-components") {
			@popui.Description() {
				Each component maps to the PopUI component of the same name, so its props are documented on that component's page.
			}
			@modules.APITable(modules.APITableProps{Items: jsonuiComponentItems()})
		}
		@modules.Section("Actions", "json-ui-actions") {
			@popui.Description() {
				Actions are implemented in jsonui.js, which must be on the page with PopUI's assets and Alpine.js. String params can include data with placeholders such as { `"Hello {{customer.name}}"` }, filled in when the action runs.
			}
			@modules.APITable(modules.APITableProps{
				Title: "Built-in actions",
				Items: []modules.APITableItem{
					{Name: "alert", Type: "message", Description: "Shows `message` in the browser's alert dialog."},
					{Name: "set", Type: "path, value", Description: "Sets the data at `path` to `value`."},
					{Name: "reset", Type: "", Description: "Restores the document's data to its initial values."},
					{Name: "dispatch", Type: "event, detail", Description: "Dispatches a bubbling DOM event named `event`, with `detail` or else a snapshot of the data, for the host page to handle."},
				},
			})
			@modules.APITable(modules.APITableProps{
				Title: "Params for every action",
				Items: []modules.APITableItem{
					{Name: "into", Type: "string", Description: "Data path to store the action's result in. Skipped when the action returns nothing, e.g. a cancelled file picker."},
					{Name: "busy", Type: "string", Description: "Data path that is true while the action runs, e.g. to show a loading state."},
				},
			})
			@popui.Description() {
				Host pages add their own actions with popui.actions.register, and must also allow them when rendering:
			}
			@modules.CodeBlock(modules.CodeBlockProps{Code: jsonuiActionsExample, Language: "markup"})
		}
		@modules.Section("Strict mode", "json-ui-strict") {
			@popui.Description() {
				Documents are untrusted by default, so a document can't run script on the host page beyond the actions the host allows. Rendering fails with an error when a document has:
			}
			<ul class="list-disc pl-5 flex flex-col gap-1 text-foreground-default-secondary">
				<li>Alpine directives, event handler attributes or htmx attributes in props or bound values</li>
				<li>URLs that can run script, such as javascript:, in props or bound values</li>
				<li>text binds that aren't paths in the document's data</li>
				<li>data paths through __proto__, prototype or constructor</li>
				<li>actions the host hasn't allowed, or unknown handlers</li>
			</ul>
			@modules.APITable(modules.APITableProps{
				Title: "jsonui.Options",
				Items: []modules.APITableItem{
					{Name: "Actions", Type: "[]string", Default: "BuiltinActions", Description: "The actions documents may use. An empty slice allows none."},
					{Name: "Trusted", Type: "bool", Default: "false", Description: "Turns the strict checks off, for documents from a trusted source."},
				},
			})
		}
		@modules.Section("Rendering in Go", "json-ui-go") {
			@modules.CodeBlock(modules.CodeBlockProps{Code: jsonuiGoExample, Language: "go"})
			@popui.Description() {
				The package embeds jsonui.js for apps to serve:
			}
			@modules.CodeBlock(modules.CodeBlockProps{Code: jsonuiAssetsExample, Language: "go"})
		}
		@modules.Section("Rendering in the browser", "json-ui-browser") {
			@popui.Description() {
				Each release publishes PopUI's assets, jsonui.js and the WebAssembly renderer to { "https://assets.invopop.com/popui/<version>/" }. Load every file from the same version: wasm_exec.js must match the Go that built popui.wasm. The renderer adds popuiRender(json, options), which returns the HTML or an error, and dispatches popui:ready once it's available.
			}
			@modules.CodeBlock(modules.CodeBlockProps{Code: jsonuiBrowserExample, Language: "markup"})
		}
		@modules.Section("Editor support", "json-ui-schema") {
			@popui.Description() {
				Set "$schema" to the document schema, which is generated from the same components and props as the renderer, for completion, documentation on hover and validation in editors such as VS Code. Each release publishes it as schema.json next to the other assets; it's also embedded in Go as schema.Document in the jsonui/schema package.
			}
			@modules.CodeBlock(modules.CodeBlockProps{Code: `{ "$schema": "https://assets.invopop.com/popui/v0.75.0/schema.json", "components": [] }`, Language: "json"})
		}
	}
}

// jsonuiComponentItems lists the components documents can use, from the
// jsonui registry, so the table can't fall behind the renderer.
func jsonuiComponentItems() []modules.APITableItem {
	items := []modules.APITableItem{
		{Name: "text", Type: "-", Description: "Plain text from `text`, or a data value from `bind`."},
	}
	for _, c := range jsonui.Components() {
		var notes []string
		if c.Model {
			notes = append(notes, "Form control: accepts `model`.")
		}
		if c.Children {
			notes = append(notes, "Takes `children`.")
		}
		if c.Events != nil {
			notes = append(notes, "Events: `"+strings.Join(c.Events, "`, `")+"`.")
		}
		items = append(items, modules.APITableItem{
			Name:        c.Name,
			Type:        "props." + c.Props.Name(),
			Description: strings.Join(notes, " "),
		})
	}
	return items
}
