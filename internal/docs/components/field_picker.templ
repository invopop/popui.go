// Package components provides documentation pages for PopUI components.
package components

import (
	_ "embed"
	"github.com/invopop/popui.go/internal/docs/examples"
	"github.com/invopop/popui.go/internal/docs/modules"
)

templ FieldPicker() {
	@modules.Example(modules.ExampleProps{
		Description: "Put the caret somewhere in the body, then pick a field: it is wrapped in the Format and inserted there. ScalarsOnly keeps objects and arrays browse-only — in a template they would print as a Go map dump — so `supplier` opens rather than picks, and `$tags[]`, with nothing underneath, is disabled. Type to filter the whole tree, or browse it a level at a time with the breadcrumb — terms are matched against the full path, so \"sup name\", \"supplier.name\" and \"supname\" all find the same field.",
		Code:        examples.LoadExample("field_picker.templ"),
	}) {
		@examples.FieldPickerExample()
	}
	@modules.Example(modules.ExampleProps{
		Title:       "Other Template Syntaxes",
		Description: "Format is whatever the template on the other end expects, with `%s` standing for the path. The target can be a Textarea or an Input as well as a contenteditable; each remembers its own caret.",
		Code:        examples.LoadExample("field_picker_textarea.templ"),
	}) {
		@examples.FieldPickerTextareaExample()
	}
	@modules.Example(modules.ExampleProps{
		Title:       "Custom Trigger",
		Description: "Whatever is in the children slot is the trigger — a Button of another variant, or a read-only Input bound to `value`, which makes the picker behave like a select. Set Value to preselect a path: the panel then opens where that value lives rather than at the root.",
		Code:        examples.LoadExample("field_picker_custom_trigger.templ"),
	}) {
		@examples.FieldPickerCustomTriggerExample()
	}
	@modules.Example(modules.ExampleProps{
		Title:       "Hybrid: an App's Variables and the Document",
		Description: "The Slack and email apps compute a handful of ready-to-print variables in Go — a joined invoice code, a rendered fault list, the job id — which is where objects get their pretty form. Those go at the top as plain fields, and the whole document sits one row down, nested under `doc` with `goblfields.Nest` so one Format serves both: `{{.full_code}}` next to `{{.doc.totals.payable}}`.",
		Code:        examples.LoadExample("field_picker_hybrid.templ"),
	}) {
		@examples.FieldPickerHybridExample()
	}
	@modules.Example(modules.ExampleProps{
		Title:       "Reacting to a Pick",
		Description: "Every pick raises a `field-select` DOM event on the component root, carrying the path, the value emitted, the field's type, and whether it was inserted into a target. The root is also x-modelable, so an Alpine x-model on it two-way binds the value.",
		Code:        examples.LoadExample("field_picker_on_select.templ"),
	}) {
		@examples.FieldPickerOnSelectExample()
	}
	@modules.Section("Building a GOBL tree", "gobl") {
		@modules.Example(modules.ExampleProps{
			Description: "The goblfields package builds a tree from the GOBL JSON Schemas embedded in the gobl module — no requests, and the fields are pinned to the GOBL release go.mod already selects. Building walks a few dozen documents, so build once and reuse the result.",
			Code:        goblFieldsSnippet,
			Stacked:     true,
		})
	}
	@modules.Section("API Reference", "api") {
		@modules.APITable(modules.APITableProps{
			Title:       "FieldPicker",
			Description: "Picks one field of a nested data shape, with filtering, drill-down browsing and full keyboard operation, and inserts it into a template.",
			Items: []modules.APITableItem{
				{Name: "ID", Type: "string", Default: "", Description: "Unique identifier, applied to the default trigger. Auto-generated when omitted so the label links correctly"},
				{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes for the default trigger button"},
				{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes, applied to the component root — the element exposed via x-modelable, so an Alpine x-model there two-way binds the value"},
				{Name: "Name", Type: "string", Default: "", Description: "Name of the hidden input the value is submitted under"},
				{Name: "Label", Type: "string", Default: "", Description: "Simple label text displayed above the trigger"},
				{Name: "Tooltip", Type: "props.Tooltip", Default: "", Description: "Tooltip card shown on hover of a question mark icon after the label; only used when Label is set"},
				{Name: "TriggerLabel", Type: "string", Default: "\"Insert field\"", Description: "Text of the default trigger button. Ignored when the children slot supplies the trigger"},
				{Name: "Value", Type: "string", Default: "", Description: "The initial value. The panel opens where it lives rather than at the root"},
				{Name: "Root", Type: "string", Default: "\"root\"", Description: "Label of the first breadcrumb, naming what the tree describes: `bill/invoice`, `envelope`"},
				{Name: "Fields", Type: "[]props.Field", Default: "", Description: "The tree to pick from, usually built with `goblfields.Build`"},
				{Name: "Format", Type: "string", Default: "\"%s\"", Description: "What a picked path is wrapped in, `%s` standing for the path: `{{.doc.%s}}` turns `supplier.name` into `{{.doc.supplier.name}}`. A field with a Value of its own is emitted as is"},
				{Name: "Target", Type: "string", Default: "", Description: "CSS selector for an input, textarea or contenteditable element. When set, a pick is inserted there at the caret, replacing any selection, with the caret left after it"},
				{Name: "ScalarsOnly", Type: "bool", Default: "false", Description: "Makes objects and arrays browse-only: they can be opened but not picked, and one with nothing underneath is shown disabled. For templates, where a picked object would print as a Go map dump"},
				{Name: "Disabled", Type: "bool", Default: "false", Description: "Disables the default trigger and keeps the panel closed"},
				{Name: "Required", Type: "bool", Default: "false", Description: "Marks the hidden input as required for form validation"},
				{Name: "Error", Type: "props.Error", Default: "", Description: "Error configuration to display validation feedback below the trigger"},
			},
		})
		@modules.APITable(modules.APITableProps{
			Title:       "Field",
			Description: "One entry in the tree. Paths are dotted, with `[]` marking each array crossed on the way: `lines[].item.name`.",
			Items: []modules.APITableItem{
				{Name: "Name", Type: "string", Default: "", Description: "The last segment of the path, without the array marker. Shown while browsing"},
				{Name: "Path", Type: "string", Default: "", Description: "The full dotted path from the root. Shown while filtering, and what Format wraps"},
				{Name: "Value", Type: "string", Default: "", Description: "Emitted as is when set, bypassing Format — for a variable that is not part of the tree's document, say"},
				{Name: "Description", Type: "string", Default: "", Description: "Long description, shown after the path and as the row's tooltip, truncating before the path does. Never searched — filtering matches the path alone. `goblfields` leaves it out unless `Options.Descriptions` is set: they roughly double the payload"},
				{Name: "Type", Type: "string", Default: "", Description: "JSON Schema type: `string`, `object`, `array`, `integer`, `number`, `boolean`. Shown abbreviated in the row; carried in full on the event"},
				{Name: "Array", Type: "bool", Default: "false", Description: "Marks a field that is itself an array. Its children describe one item"},
				{Name: "Required", Type: "bool", Default: "false", Description: "Marks a field its immediate parent requires"},
				{Name: "AlwaysPresent", Type: "bool", Default: "false", Description: "Marks a field required at every step from the root, shown with a green dot. Inside an array it reads per item: `lines[].item` is marked when every line that exists carries an item"},
				{Name: "Children", Type: "[]props.Field", Default: "", Description: "The fields one level down, for a field that can be drilled into"},
			},
		})
		@modules.APITable(modules.APITableProps{
			Title:       "goblfields.Options",
			Description: "Tune how `goblfields.Build` walks the schemas.",
			Items: []modules.APITableItem{
				{Name: "MaxDepth", Type: "int", Default: "6", Description: "How far a branch is expanded, counting the root document's properties as depth 1. A branch also stops on its own when it revisits a schema it already contains, which is what bounds recursive schemas"},
				{Name: "Descriptions", Type: "bool", Default: "false", Description: "Keeps each field's schema description, which is what a row shows after the path. They run to several lines for many GOBL fields, and roughly double the payload sent to the browser — without them a row shows just its path"},
				{Name: "Source", Type: "fs.FS", Default: "goblfields.Schemas", Description: "Where schema documents are read from. Defaults to the documents embedded in the gobl module"},
			},
		})
	}
}

//go:embed field_picker_gobl.go.txt
var goblFieldsSnippet string
