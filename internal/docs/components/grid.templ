package components

import (
	_ "embed"
	"github.com/invopop/popui.go/internal/docs/examples"
	"github.com/invopop/popui.go/internal/docs/modules"
)

templ Grid() {
	@modules.Example(modules.ExampleProps{
		Description: "The sections of a document: its details take two rows beside the supplier and the customer, with dashed lines between them, and the totals a row of their own below a solid line. On narrow screens the cells stack, and the details' right border is drawn below them instead.",
		Code:        examples.LoadExample("grid.templ"),
	}) {
		@examples.GridExample()
	}
	@modules.Section("API Reference", "api") {
		@modules.APITable(modules.APITableProps{
			Title:       "Grid",
			Description: "Columns of Cell children, which stack in one column on narrow screens. In JSON UI: \"grid\".",
			Items: []modules.APITableItem{
				{Name: "ID", Type: "string", Default: "", Description: "Unique identifier for the grid"},
				{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to merge with the grid's styles"},
				{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes (data-*, aria-*, etc.)"},
				{Name: "Columns", Type: "int", Default: "2", Description: "Number of columns, from 1 to 4"},
				{Name: "Stack", Type: "string", Default: "\"md\"", Description: "Breakpoint below which the cells stack: \"sm\", \"md\", \"lg\" or \"xl\", or \"none\" to keep the columns at every width (GridStackSmall, …, GridStackNone)"},
			},
		})
		@modules.APITable(modules.APITableProps{
			Title:       "Cell",
			Description: "A section of a Grid, padded, with the lines on its edges (props.GridCell). In JSON UI: \"cell\".",
			Items: []modules.APITableItem{
				{Name: "ID", Type: "string", Default: "", Description: "Unique identifier for the cell"},
				{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to merge with the cell's styles"},
				{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes (data-*, aria-*, etc.)"},
				{Name: "Span", Type: "int", Default: "1", Description: "Number of columns the cell takes"},
				{Name: "Rows", Type: "int", Default: "1", Description: "Number of rows the cell takes, beside cells stacked in the other columns"},
				{Name: "Borders", Type: "[]props.Border", Default: "", Description: "Lines on the cell's edges: each an Edge (\"top\", \"right\", \"bottom\" or \"left\") and a Style (\"solid\" or \"dashed\"). While the grid is stacked, a right border is drawn at the bottom and a left one at the top, unless the cell has its own there."},
			},
		})
	}
}
