package components

import (
	_ "embed"
	"github.com/invopop/popui.go/internal/docs/examples"
	"github.com/invopop/popui.go/internal/docs/modules"
)

templ Accordion() {
	@modules.Example(modules.ExampleProps{
		Code: examples.LoadExample("accordion.templ"),
	}) {
		@examples.AccordionExample()
	}
	@modules.Example(modules.ExampleProps{
		Title:       "Accordion groups",
		Description: "Wrap related accordions in AccordionGroup to join them into a single bordered panel with dividers between items.",
		Code:        examples.LoadExample("accordion_group.templ"),
	}) {
		@examples.AccordionGroupExample()
	}
	@modules.Example(modules.ExampleProps{
		Title:       "Icons and actions",
		Description: "Icon goes before the title, and Actions after it, as for the steps a job ran: how long each took, its status, or a button.",
		Code:        examples.LoadExample("accordion_icon.templ"),
	}) {
		@examples.AccordionIconExample()
	}
	@modules.Example(modules.ExampleProps{
		Title:       "Panels",
		Description: "The panel variant is for the panels beside a page's content, on a white work area: a compact header divided from the content, a plain icon, and a shadow.",
		Code:        examples.LoadExample("accordion_panel.templ"),
	}) {
		@examples.AccordionPanelExample()
	}
	@modules.Section("API Reference", "api") {
		@modules.APITable(modules.APITableProps{
			Title:       "Accordion",
			Description: "Collapsible section using the HTML details element. Title renders in the trigger and children are the content.",
			Items: []modules.APITableItem{
				{Name: "ID", Type: "string", Default: "", Description: "Unique identifier for the accordion element"},
				{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to merge with base styles"},
				{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the details element"},
				{Name: "Open", Type: "bool", Default: "false", Description: "Whether the accordion is initially expanded"},
				{Name: "Title", Type: "string", Default: "", Description: "Text shown in the trigger"},
				{Name: "Variant", Type: "string", Default: "default", Description: "\"default\", or \"panel\" for a panel beside a page's content: compact, with a divided header, a plain icon and a shadow"},
				{Name: "Icon", Type: "templ.Component", Default: "", Description: "Shown before the title, such as an icon or an image: in a small tile, or plain on the panel variant"},
				{Name: "Actions", Type: "templ.Component", Default: "", Description: "Shown after the title, before the chevron. Clicking a button or link there doesn't open or close the accordion"},
			},
		})
		@modules.APITable(modules.APITableProps{
			Title:       "AccordionGroup",
			Description: "Joins several Accordion children into one bordered panel with dividers between them.",
			Items: []modules.APITableItem{
				{Name: "ID", Type: "string", Default: "", Description: "Unique identifier for the group element"},
				{Name: "Class", Type: "string", Default: "", Description: "Additional CSS classes to merge with base styles"},
				{Name: "Attributes", Type: "templ.Attributes", Default: "", Description: "Additional HTML attributes to apply to the group div"},
			},
		})
	}
}
