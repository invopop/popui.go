// Package components provides documentation pages for PopUI components.
package components

import (
	"github.com/invopop/popui.go/internal/docs/examples"
	"github.com/invopop/popui.go/internal/docs/modules"
)

templ SubscriptionPhases() {
	@modules.Example(modules.ExampleProps{
		Title:         "Phase and product editor",
		Description:   "A subscription's phases sit side by side as CardDecks on a plane that scrolls horizontally once it outgrows the page. Each deck holds the phase's start date, one Card per product billed during the phase, and a nested Add a product menu that opens upwards: Custom product at the top level, then a submenu per catalog group. Add phase clones the last phase, starts it a month later and scrolls the plane to reveal it; the head menu duplicates or removes a phase.",
		Code:          examples.LoadExample("subscription_phases.templ"),
		IframeContent: examples.SubscriptionPhasesExample(),
		Stacked:       true,
	})
	@modules.Section("Anatomy", "anatomy") {
		<ul class="flex flex-col gap-2 text-base text-foreground-default-secondary">
			<li>
				<span class="font-medium text-foreground">Plane.</span>
				A flex row with <code class="font-mono text-sm bg-background-default-secondary px-1.5 py-0.5 rounded">overflow-x-auto snap-x</code>; each deck is <code class="font-mono text-sm bg-background-default-secondary px-1.5 py-0.5 rounded">w-140 shrink-0 snap-start self-start</code> so decks keep their width, snap into view, and only grow as tall as their own content.
			</li>
			<li>
				<span class="font-medium text-foreground">Phase deck.</span>
				A CardDeck per phase. The CardDeckHead carries the phase number, a TagStatus for its state (current, scheduled, ended) and a Menu with duplicate and remove.
			</li>
			<li>
				<span class="font-medium text-foreground">Schedule card.</span>
				The first Card holds the start date. A phase ends when the next one starts, so the end is shown as text rather than a second field.
			</li>
			<li>
				<span class="font-medium text-foreground">Product cards.</span>
				One Card per product: its position, a quantity Input, the product (a Select over the catalog, or a free-text name for a custom product), a discount with its unit and reason, and edit and remove actions. Usage-priced products have no quantity.
			</li>
			<li>
				<span class="font-medium text-foreground">Details editor.</span>
				The pencil expands the card: feature, included features (a multiple Select), pricing strategy with a short explanation, grant and grant interval, and a price Table of ranges with amounts and a per-unit flag, plus Add price. Custom products open expanded.
			</li>
			<li>
				<span class="font-medium text-foreground">Add a product.</span>
				A Menu in the deck's footer row, opened upwards with DropUp. Custom product sits at the top level; each catalog group is a MenuSub whose flyout lists its products. The footer also totals the phase for the chosen cadence and currency.
			</li>
			<li>
				<span class="font-medium text-foreground">Add phase tile.</span>
				A dashed tile on the deck's own gray at the end of the plane. It and the header button both create a phase, which inherits the previous phase's products and starts on the same day of the following month.
			</li>
		</ul>
	}
}
