package popui

import (
	"github.com/invopop/icons"
	"github.com/invopop/popui.go/classes"
	"github.com/invopop/popui.go/props"
	"github.com/invopop/popui.go/tailwind"
)

// SplitButton pairs a main action Button with an attached chevron toggle that
// opens a dropdown of related actions. The main segment carries the default
// action (a form button or an anchor, configured via the Button prop); the
// toggle opens a Menu-style panel rendered from the children slot — use
// MenuItem for each action, exactly as within a Menu. Supports dynamic IDs
// via Alpine.js x-id for use in repeated templates.
templ SplitButton(opts ...props.SplitButton) {
	{{ p := props.First(opts).GenerateID() }}
	{{ btn := p.Button }}
	{{ btn.Class = tailwind.Merge("rounded-r-none border-r-0", btn.Class) }}
	<div
		x-data
		x-id="['split-button']"
		:style="'anchor-name: --split-button-' + $id('split-button')"
		class={
			tailwind.Merge(
				"relative inline-flex max-w-full",
				p.Class,
			),
		}
		if p.ID != "" {
			id={ p.ID }
		}
		{ p.Attributes... }
	>
		@Button(btn) {
			if p.Icon != nil {
				@p.Icon
			}
			if p.Content != nil {
				@p.Content
			} else {
				<span>{ p.Label }</span>
			}
		}
		// The segments sit flush (no overlap): the main segment drops its
		// right border and the toggle's left border is the single divider
		// line, so nothing stacks, flips paint order, or casts a shadow
		// sliver across the seam. The [:hover+&] variant darkens the divider
		// while the MAIN segment is hovered, completing its hover ring, and
		// [&:has(+:popover-open)] holds the toggle's hover styles while its
		// menu (the next sibling popover) is open. Borderless variants
		// (secondary, transparent) reinstate just the divider with an
		// explicit border-l. The popui-icon-xs marker scales the chevron
		// down to the 12px icon size.
		@Button(props.Button{
			Variant:  p.Button.Variant,
			Size:     p.Button.Size,
			Disabled: p.Button.Disabled,
			Class: tailwind.Merge(
				// The explicit width matches the height each Size gives the
				// segments (28px md, 24px sm, 32px lg), keeping the toggle a
				// square (aspect-square can't: as a flex item with content-
				// based height, it has no definite size to transfer from).
				// active:translate-y-0 overrides the base button's 1px press
				// dip: the toggle opens a menu rather than performing an
				// action, so it stays put when clicked (the pressed shadow
				// still gives feedback).
				"shrink-0 rounded-l-none px-0 w-7 popui-icon-xs active:translate-y-0",
				classes.If(p.Button.Size == props.ButtonSizeSmall, "w-6"),
				classes.If(p.Button.Size == props.ButtonSizeLarge, "w-8"),
				classes.If(p.Button.Variant == "",
					"[:hover+&]:border-l-border-default-secondary-hover [&:has(+:popover-open)]:border-border-default-secondary-hover"),
				classes.If(p.Button.Variant == props.ButtonVariantPrimary,
					"border-l-background-accent-hover hover:border-l-background-accent-press active:border-l-background-accent-press [:hover+&]:border-l-background-accent-press [&:has(+:popover-open)]:bg-background-accent-hover [&:has(+:popover-open)]:border-l-background-accent-press"),
				classes.If(p.Button.Variant == props.ButtonVariantSecondary || p.Button.Variant == props.ButtonVariantTransparent,
					"border-l border-l-border hover:border-l-border active:border-l-border [&:has(+:popover-open)]:bg-background-default-tertiary-hover"),
				classes.If(p.Button.Variant == props.ButtonVariantTransparent,
					"[&:has(+:popover-open)]:shadow-button-default"),
			),
			Attributes: templ.Attributes{
				"aria-haspopup":        "menu",
				"aria-label":           toggleLabel(p.ToggleLabel),
				"x-bind:popovertarget": "$id('split-button')",
			},
		}) {
			@icons.ChevronDown()
		}
		<div
			popover
			:id="$id('split-button')"
			:style="'position-anchor: --split-button-' + $id('split-button')"
			class={
				tailwind.Merge(
					// Same panel treatment as Menu: context-menu-scroll caps the
					// panel at the viewport edge (see components.css); the flex
					// column lets the ul below scroll inside while the padding
					// stays put, and items truncate against the max width.
					"context-menu context-menu-scroll flex flex-col",
					"border border-border rounded-xl py-1 w-fit min-w-48 max-w-80 bg-background shadow-lg",
					classes.If(!p.DropUp, "mt-1"),
					classes.If(p.DropUp, "mb-1 context-menu-up"),
					classes.If(p.RightAlign, "context-menu-right-align"),
					p.MenuClass,
				),
			}
		>
			<ul role="menu" class="min-h-0 overflow-y-auto overflow-x-hidden px-1">
				{ children... }
			</ul>
		</div>
	</div>
}

func toggleLabel(label string) string {
	if label == "" {
		return "More actions"
	}
	return label
}
