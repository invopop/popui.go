package popui

import (
	"github.com/invopop/icons"
	"github.com/invopop/popui.go/classes"
	"github.com/invopop/popui.go/props"
	"github.com/invopop/popui.go/tailwind"
	"strings"
)

// Sidebar provides a wrapper for sidebars on admin panels.
// At the `md` breakpoint and above the sidebar is visible by default via the
// `md:w-[240px]` and `md:visible` base classes. JavaScript then adds the
// `popui-sidebar-ready` class to enable toggle behavior, using the
// `popui-sidebar-open` class to represent the "open" state once ready. Below
// `md`, the Header's built-in menu button toggles `popui-sidebar-open`.
templ Sidebar(opts ...props.Sidebar) {
	{{ p := props.First(opts) }}
	<nav
		id="popui-sidebar"
		class={
			tailwind.Merge(
				// Item labels wrapped in a <span> gain an ellipsis when they
				// exceed the sidebar width; raw text nodes are still clipped.
				"h-full w-0 md:w-[240px] invisible md:visible bg-background flex flex-col items-center gap-0 transition-[width] ease-in-out duration-300 border-r border-border [&_ul_li_a]:whitespace-nowrap [&_ul_li_a]:overflow-hidden [&_ul_li_a_div]:shrink-0 [&_ul_li_a_span]:truncate",
				classes.If(p.Variant == props.SidebarVariantDark, "sidebar-dark"),
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</nav>
}

// SidebarHeader provides a header for the sidebar
templ SidebarHeader() {
	// A workspace name wrapped in a <span> truncates with an ellipsis; raw
	// text nodes are clipped by the overflow-hidden instead.
	<div class="SidebarHeader w-full flex pl-5 pr-3 py-3 items-center gap-2 border-b border-border text-foreground font-sans text-base font-semibold whitespace-nowrap h-12 overflow-hidden [&>div]:!w-7 [&>div]:!h-7 [&>div]:shrink-0 [&>span]:truncate">
		{ children... }
	</div>
}

// SidebarContent provides a wrapper for the content of the sidebar
templ SidebarContent() {
	<div class="w-full flex grow min-h-0 pt-5 pb-3 px-3 flex-col items-center gap-6 overflow-y-auto">
		{ children... }
	</div>
}

// Sidebar provides a wrapper for a ul element used in Sidebar component.
// Expects either a set of `<li>` or SidebarItem components.
templ SidebarSection(opts ...props.SidebarSection) {
	{{ p := props.First(opts) }}
	<div
		class={
			tailwind.Merge(
				"w-full flex flex-col items-start gap-2 [&_p]:text-foreground-default-secondary [&_p]:font-sans [&_p]:text-sm [&_p]:font-medium [&_p]:indent-2 [&_ul]:flex [&_ul]:flex-col [&_ul]:items-start [&_ul]:w-full [&_ul]:gap-0.5 [&_ul_li]:w-full [&_a]:w-full [&_a]:flex [&_a]:py-1.5 [&_a]:px-2 [&_a]:items-center [&_a]:gap-1.5 [&_a]:rounded-lg [&_a]:text-foreground [&_a]:font-sans [&_a]:text-base [&_a]:font-medium [&_a:hover]:bg-background-default-secondary [&_svg_*[stroke]]:stroke-[var(--color-icon-default-default)] [&_svg_*[fill]]:fill-[var(--color-icon-default-default)]",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		if p.Title != "" {
			<p>{ p.Title }</p>
		}
		<ul>
			{ children... }
		</ul>
	</div>
}

// SidebarItem provides an individual item for the SidebarSection component.
// All attributes provided in Attributes will be added to the `<a>` element embedded
// inside the `<li>`. If you need to select the item using javascript, apply
// the `bg-background-default-secondary` class, for static rendering use the
// `Selected` property.
templ SidebarItem(opts ...props.SidebarItem) {
	{{ p := props.First(opts) }}
	<li>
		<a
			if p.ID != "" {
				id={ p.ID }
			}
			if p.Href != "" {
				href={ p.Href }
			}
			class={
				tailwind.Merge(
					classes.If(p.Selected, "bg-background-default-secondary"),
					p.Class,
				),
			}
			{ p.Attributes... }
		>
			{ children... }
		</a>
	</li>
}

// SidebarFooter provides a footer for the sidebar
templ SidebarFooter() {
	<div class="SidebarFooter grow-0 border-t border-border-default-secondary py-2 px-4 w-full">
		{ children... }
	</div>
}

// SidebarGroup nests SidebarItems under a header row — an organization and
// its areas, a project and its pages. The children indent behind a tree
// line. Place it inside a SidebarSection, whose descendant styles it shares.
//
// The header is the group's Label (or the Header component when set). With
// HeaderAttributes it becomes an interactive row — an href, an hx-get, an
// @click — and gains a trailing chevron to say so.
templ SidebarGroup(opts ...props.SidebarGroup) {
	{{ p := props.First(opts) }}
	<li
		if p.ID != "" {
			id={ p.ID }
		}
		class={ tailwind.Merge("w-full", p.Class) }
		{ p.Attributes... }
	>
		if len(p.HeaderAttributes) > 0 {
			<a class="cursor-pointer" { p.HeaderAttributes... }>
				@sidebarGroupHeader(p)
				<div class="ml-auto flex h-5 w-5 items-center justify-center rounded-md border border-border bg-background">
					@icons.ChevronDown()
				</div>
			</a>
		} else {
			// Mirrors the section's link styling minus the hover state, so
			// static and interactive headers line up.
			<div class="w-full flex py-1.5 px-2 items-center gap-1.5 text-foreground font-sans text-base font-medium">
				@sidebarGroupHeader(p)
			</div>
		}
		// The wrapper's padding sets the indent; the ul keeps the section's
		// full-width styling inside it and draws the tree line.
		<div class="w-full pl-3.5 pt-0.5">
			<ul class="border-l border-border pl-1">
				{ children... }
			</ul>
		</div>
	</li>
}

templ sidebarGroupHeader(p props.SidebarGroup) {
	if p.Header != nil {
		@p.Header
	} else {
		<span>{ p.Label }</span>
	}
}

// SidebarUser pins the signed-in person to the bottom of the sidebar:
// avatar, name and email. Clicking the row opens a menu of account actions
// above it — pass MenuItems as children. Place it inside a SidebarFooter.
templ SidebarUser(opts ...props.SidebarUser) {
	{{ p := props.First(opts) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ tailwind.Merge("w-full", p.Class) }
		{ p.Attributes... }
	>
		@Menu(props.Menu{
			DropUp:       true,
			RootClass:    "block w-full",
			TriggerClass: "w-full",
			Trigger:      sidebarUserRow(p),
		}) {
			{ children... }
		}
	</div>
}

templ sidebarUserRow(p props.SidebarUser) {
	<div class="w-full flex items-center gap-2 rounded-lg px-2 py-1.5 text-left hover:bg-background-default-secondary">
		@Avatar(props.Avatar{Size: props.AvatarSizeLarge, Initial: sidebarUserInitial(p)}) {
			if p.AvatarURL != "" {
				@Image(props.Image{Src: p.AvatarURL, Alt: p.Name})
			}
		}
		<div class="flex min-w-0 flex-1 flex-col">
			<span class="truncate font-sans text-base font-medium text-foreground">{ p.Name }</span>
			<span class="truncate font-sans text-sm text-foreground-default-secondary">{ p.Email }</span>
		</div>
	</div>
}

// sidebarUserInitial is the avatar fallback: empty while a picture is set
// (so the Avatar renders its Image child), otherwise the first letter of
// the name, or of the email when there is no name.
func sidebarUserInitial(p props.SidebarUser) string {
	if p.AvatarURL != "" {
		return ""
	}
	src := strings.TrimSpace(p.Name)
	if src == "" {
		src = strings.TrimSpace(p.Email)
	}
	if src == "" {
		return "?"
	}
	return strings.ToUpper(string([]rune(src)[0]))
}
