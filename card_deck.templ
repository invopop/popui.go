package popui

import (
	"github.com/invopop/icons"
	"github.com/invopop/popui.go/classes"
	"github.com/invopop/popui.go/props"
	"github.com/invopop/popui.go/tailwind"
)

// CardDeck stacks regular Card children on a tinted background — use it to
// group related cards into one visual unit (billing plans, payment methods,
// addresses). Lead with an optional CardDeckHead for a label and action.
//
// With props.CardDeck.Reorderable the deck also becomes a drag-to-reorder
// list, driven by a CardDeckReorderButton in the head. Entering reorder mode
// fades a drag handle in at each card's left edge, shakes the cards briefly,
// and disables every button in the deck bar the toggle; clicks are captured on the deck so a card's own handlers and an
// anchor Card's navigation are both stopped while reordering. Cards are moved
// by dragging only — none of them is selectable or focusable, and Escape is
// the one key bound, to leave the mode. The optional Name renders a hidden
// input (so display:none, out of the flex flow) carrying the order for a form
// submit.
templ CardDeck(opts ...props.CardDeck) {
	{{ p := props.First(opts) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		if p.Reorderable {
			x-data="cardDeckReorder()"
			:class="{ 'popui-card-deck-reordering': reordering }"
			@pointerdown="onPointerDown"
			@keydown="onKeydown"
			@click.capture="onClick"
		}
		class={
			tailwind.Merge(
				// Child cards get a smaller radius so their corners run
				// concentric with the deck's rounded-2xl outline.
				"flex flex-col gap-0.5 p-0.5 rounded-2xl bg-background-default-secondary w-full [&>[data-card]]:rounded-xl",
				// Static, unlike the -reordering class: it gives each card its
				// collapsed drag handle, which needs to exist up front to have
				// something to animate in from.
				classes.If(p.Reorderable, "popui-card-deck-sortable"),
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
		if p.Reorderable && p.Name != "" {
			<input type="hidden" name={ p.Name } :value="order.join(',')"/>
		}
	</div>
}

// CardDeckHead is the small muted header row of a CardDeck: a label on the
// left and any trailing content (a Button, a TagStatus) on the right.
templ CardDeckHead(opts ...props.CardDeckHead) {
	{{ p := props.First(opts) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ tailwind.Merge(
			"text-sm font-medium text-foreground-default-secondary flex items-center justify-between gap-1 py-1.5 px-2.5",
			p.Class,
		) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// CardDeckReorderButton toggles the reorder mode of the CardDeck it sits in,
// flipping between a plain "Reorder" and a green, ticked "Done". Place it as the trailing
// content of a CardDeckHead, inside a CardDeck built with Reorderable set —
// it reads that deck's Alpine scope, so it does nothing on its own. Its
// data-card-deck-reorder marker is what keeps it alive while reorder mode
// disables every other button in the deck.
templ CardDeckReorderButton(opts ...props.CardDeckReorderButton) {
	{{ p := props.First(opts) }}
	@Button(props.Button{
		ID:    p.ID,
		Type:  "button",
		Size:  props.ButtonSizeSmall,
		Class: tailwind.Merge("bg-background", p.Class),
		Attributes: mergeAttributes(templ.Attributes{
			"data-card-deck-reorder": "",
			"@click":                 "toggleReorder",
			":aria-pressed": "reordering ? 'true' : 'false'",
			// Bang-prefixed, as the resting button's own background, border,
			// hover states and icon colour would otherwise win by stylesheet
			// order. The tick takes icon-inverse, the translucent white the
			// Button primitive gives icons on a bold ground, not the opaque
			// foreground the label uses.
			":class": "reordering ? '!bg-background-success-bold !text-foreground-inverse !border-transparent hover:!bg-background-success-bold [&_svg]:!text-icon-inverse' : ''",
		}, p.Attributes),
	}) {
		<span x-show="!reordering">{ p.ReorderLabel() }</span>
		<div class="flex items-center gap-1" x-show="reordering" x-cloak>
			@icons.Tick()
			<span>{ p.ReorderDoneLabel() }</span>
		</div>
	}
}
