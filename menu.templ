package popui

import (
	"github.com/invopop/popui.go/classes"
	"github.com/invopop/popui.go/props"
	"github.com/invopop/popui.go/tailwind"
)

// Menu provides a trigger Button that opens a dropdown menu of actions.
// The default trigger is a "···" icon button, customizable via ButtonLabel
// and ButtonVariant. Menu items render from the children slot — use
// MenuItem for each action. Supports dynamic IDs via Alpine.js x-id for use
// in repeated templates.
templ Menu(opts ...props.Menu) {
	{{ p := props.First(opts).GenerateID() }}
	<div
		x-data
		x-id="['context-menu']"
		role="menu"
		:style="'anchor-name: --context-menu-' + $id('context-menu')"
		class={
			tailwind.Merge(
				"relative inline-block",
				classes.If(p.RightAlign, "flex justify-end"),
				p.RootClass,
			),
		}
		if p.ID != "" {
			id={ p.ID }
		}
		{ p.Attributes... }
	>
		if p.Trigger != nil {
			<button
				type="button"
				aria-haspopup="menu"
				x-bind:popovertarget="$id('context-menu')"
				class={ tailwind.Merge("cursor-pointer", p.TriggerClass) }
			>
				@p.Trigger
			</button>
		} else {
			@Button(props.Button{
				Attributes: templ.Attributes{
					"x-bind:popovertarget": "$id('context-menu')",
				},
				Size:    "icon",
				Variant: p.ButtonVariant,
			}) {
				if p.ButtonLabel != "" {
					{ p.ButtonLabel }
				} else {
					···
				}
			}
		}
		<div
			popover
			:id="$id('context-menu')"
			:style="'position-anchor: --context-menu-' + $id('context-menu')"
			class={
				tailwind.Merge(
					"context-menu",
					// max-w caps the panel when an item label is very long; the
					// items themselves truncate (see MenuItem).
					"border border-border rounded-xl p-1 w-fit min-w-48 max-w-80 bg-background shadow-lg",
					classes.If(!p.DropUp, "mt-1"),
					classes.If(p.DropUp, "mb-1 context-menu-up"),
					classes.If(p.RightAlign, "context-menu-right-align"),
					p.Class,
				),
			}
		>
			<ul>
				{ children... }
			</ul>
		</div>
	</div>
}

// MenuItem provides one action row within a Menu. The danger variant colors
// the row red for destructive actions; Selected marks the current choice of
// a picker menu with a trailing tick. Children may be richer than an icon
// and a label — an Avatar with a name works.
templ MenuItem(opts ...props.MenuItem) {
	{{ p := props.First(opts) }}
	<li
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			tailwind.Merge(
				"font-sans font-medium text-base w-full rounded-md",
				classes.If(p.Variant != props.MenuItemVariantDanger, "text-foreground hover:bg-background-default-secondary"),
				classes.If(p.Variant == props.MenuItemVariantDanger, "text-foreground-critical hover:bg-background-critical"),
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		// Label text wrapped in a <span> truncates with an ellipsis when the
		// menu hits its max width; icon wrappers (divs) keep their size.
		<div class="w-full px-2 py-1.5 flex items-center space-x-2 cursor-pointer whitespace-nowrap min-w-0 [&>span]:truncate [&>div]:shrink-0">
			{ children... }
			if p.Selected {
				<span class="ml-auto! flex size-4 shrink-0 items-center justify-center">
					@selectCheckIcon()
				</span>
			}
		</div>
	</li>
}

// MenuSeparator provides a thin horizontal line delimiting groups of
// MenuItem rows within a Menu.
templ MenuSeparator(opts ...props.MenuSeparator) {
	{{ p := props.First(opts) }}
	// Negative inline margin lets the line span the full panel width, past
	// the menu panel's p-1 padding.
	<li
		role="separator"
		aria-hidden="true"
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			tailwind.Merge(
				"-mx-1 my-1 h-px bg-border",
				p.Class,
			),
		}
		{ p.Attributes... }
	></li>
}

// MenuLabel is a non-interactive group heading within a Menu, for splitting
// a long menu into labelled sections.
templ MenuLabel(opts ...props.MenuLabel) {
	{{ p := props.First(opts) }}
	<li
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			tailwind.Merge(
				"select-none px-2 pb-1 pt-2 font-sans text-sm font-medium text-foreground-default-secondary first:pt-1",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</li>
}
