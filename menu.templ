package popui

import (
	"github.com/invopop/icons"
	"github.com/invopop/popui.go/classes"
	"github.com/invopop/popui.go/props"
	"github.com/invopop/popui.go/tailwind"
)

// Menu provides a trigger Button that opens a dropdown menu of actions.
// The default trigger is a "···" icon button, customizable via ButtonLabel,
// ButtonIcon, ButtonVariant and ButtonSize. Menu items render from the
// children slot — use MenuItem for each action and MenuSub for a nested
// level. Supports dynamic IDs via Alpine.js x-id for use in repeated
// templates.
templ Menu(opts ...props.Menu) {
	{{ p := props.First(opts).GenerateID() }}
	<div
		x-data
		x-id="['context-menu']"
		role="menu"
		:style="'anchor-name: --context-menu-' + $id('context-menu')"
		class={
			tailwind.Merge(
				"relative inline-block",
				classes.If(p.RightAlign, "flex justify-end"),
				p.RootClass,
			),
		}
		if p.ID != "" {
			id={ p.ID }
		}
		{ p.Attributes... }
	>
		if p.Trigger != nil {
			<button
				type="button"
				aria-haspopup="menu"
				x-bind:popovertarget="$id('context-menu')"
				class={ tailwind.Merge("cursor-pointer", p.TriggerClass) }
			>
				@p.Trigger
			</button>
		} else {
			@Button(props.Button{
				Attributes: templ.Attributes{
					"x-bind:popovertarget": "$id('context-menu')",
				},
				Size:    p.TriggerSize(),
				Variant: p.ButtonVariant,
			}) {
				if p.ButtonIcon != nil {
					@p.ButtonIcon
				}
				if p.ButtonLabel != "" {
					{ p.ButtonLabel }
				} else if p.ButtonIcon == nil {
					···
				}
			}
		}
		<div
			popover
			:id="$id('context-menu')"
			:style="'position-anchor: --context-menu-' + $id('context-menu')"
			class={
				tailwind.Merge(
					// context-menu-scroll caps the panel at the viewport edge
					// (see components.css); the flex column lets the ul below
					// scroll inside while the padding stays put.
					"context-menu context-menu-scroll flex flex-col",
					// max-w caps the panel when an item label is very long; the
					// items themselves truncate (see MenuItem). Horizontal
					// padding lives on the ul, not here, so MenuSeparator's
					// -mx-1 bleed isn't clipped by the ul's overflow-x.
					"border border-border rounded-xl py-1 w-fit min-w-48 max-w-80 bg-background shadow-lg",
					classes.If(!p.DropUp, "mt-1"),
					classes.If(p.DropUp, "mb-1 context-menu-up"),
					classes.If(p.RightAlign, "context-menu-right-align"),
					p.Class,
				),
			}
		>
			<ul class="min-h-0 overflow-y-auto overflow-x-hidden px-1">
				{ children... }
			</ul>
		</div>
	</div>
}

// MenuItem provides one action row within a Menu. The danger variant colors
// the row red for destructive actions; Selected marks the current choice of
// a picker menu with a trailing tick. Children may be richer than an icon
// and a label — an Avatar with a name works.
templ MenuItem(opts ...props.MenuItem) {
	{{ p := props.First(opts) }}
	<li
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			tailwind.Merge(
				"font-sans font-medium text-base w-full rounded-md",
				classes.If(p.Variant != props.MenuItemVariantDanger, "text-foreground hover:bg-background-default-secondary"),
				classes.If(p.Variant == props.MenuItemVariantDanger, "text-foreground-critical hover:bg-background-critical"),
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		// Label text wrapped in a <span> truncates with an ellipsis when the
		// menu hits its max width; icon wrappers (divs) keep their size.
		<div class="w-full px-2 py-1.5 flex items-center space-x-2 cursor-pointer whitespace-nowrap min-w-0 [&>span]:truncate [&>div]:shrink-0">
			{ children... }
			if p.Selected {
				<span class="ml-auto! flex size-4 shrink-0 items-center justify-center">
					@selectCheckIcon()
				</span>
			}
		</div>
	</li>
}

// MenuSub nests a second level of items behind one row of a Menu. The row
// shows an optional Icon, the Label and a trailing chevron; hovering or
// clicking it opens a flyout panel beside the row — to the right, flipping
// to the left at the viewport edge — holding the children: MenuItems,
// MenuSeparators, MenuLabels or further MenuSubs. The flyout is a popover
// nested inside the parent panel, so opening it keeps the parent open,
// opening a sibling submenu closes this one, and Escape closes the innermost
// panel first. Choosing an item inside does not close the menu by itself;
// hide the outermost panel from the item's handler, as with any MenuItem.
templ MenuSub(opts ...props.MenuSub) {
	{{ p := props.First(opts) }}
	<li
		if p.ID != "" {
			id={ p.ID }
		}
		x-data
		x-id="['submenu']"
		class={
			tailwind.Merge(
				"font-sans font-medium text-base w-full rounded-md text-foreground hover:bg-background-default-secondary has-[[popover]:popover-open]:bg-background-default-secondary",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		<button
			type="button"
			aria-haspopup="menu"
			x-bind:popovertarget="$id('submenu')"
			:style="'anchor-name: --submenu-' + $id('submenu')"
			@mouseenter="if (!$refs.panel.matches(':popover-open')) $refs.panel.showPopover()"
			class="w-full px-2 py-1.5 flex items-center gap-2 cursor-pointer whitespace-nowrap min-w-0 text-left [&>span]:truncate [&>div]:shrink-0"
		>
			if p.Icon != nil {
				@p.Icon
			}
			<span class="flex-1">{ p.Label }</span>
			<div class="text-icon-default-secondary">
				@icons.ChevronRight()
			</div>
		</button>
		<div
			popover
			x-ref="panel"
			:id="$id('submenu')"
			:style="'position-anchor: --submenu-' + $id('submenu')"
			class={
				tailwind.Merge(
					// context-menu-sub pins the panel beside its row (see
					// components.css); no mt-1 or scroll cap, unlike the root.
					"context-menu context-menu-sub flex flex-col",
					"border border-border rounded-xl py-1 w-fit min-w-48 max-w-80 bg-background shadow-lg",
					p.PanelClass,
				),
			}
		>
			<ul class="min-h-0 overflow-y-auto overflow-x-hidden px-1">
				{ children... }
			</ul>
		</div>
	</li>
}

// MenuSeparator provides a thin horizontal line delimiting groups of
// MenuItem rows within a Menu.
templ MenuSeparator(opts ...props.MenuSeparator) {
	{{ p := props.First(opts) }}
	// Negative inline margin lets the line span the full panel width, past
	// the item list's px-1 padding (in Menu; the Filter panels' p-1 works
	// the same way).
	<li
		role="separator"
		aria-hidden="true"
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			tailwind.Merge(
				"-mx-1 my-1 h-px bg-border",
				p.Class,
			),
		}
		{ p.Attributes... }
	></li>
}

// MenuLabel is a non-interactive group heading within a Menu, for splitting
// a long menu into labelled sections.
templ MenuLabel(opts ...props.MenuLabel) {
	{{ p := props.First(opts) }}
	<li
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			tailwind.Merge(
				"select-none px-2 pb-1 pt-2 font-sans text-sm font-medium text-foreground-default-secondary first:pt-1",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</li>
}
