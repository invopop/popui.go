package popui

import (
	"context"
	"io"

	"github.com/invopop/popui.go/props"
	"github.com/invopop/popui.go/tailwind"
)

// Grid lays out Cell children in columns, such as the sections of a
// document's card, stacking them in one column on narrow screens. Lines
// between the cells are the cells' own Borders.
templ Grid(opts ...props.Grid) {
	{{ p := props.First(opts) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-grid
		class={ tailwind.Merge(gridClass(p), p.Class) }
		{ p.Attributes... }
	>
		@withGridStack(gridStack(p)) {
			{ children... }
		}
	</div>
}

// Cell is a section of a Grid, which may span its columns and rows, with
// solid or dashed lines on its edges.
templ Cell(opts ...props.GridCell) {
	{{ p := props.First(opts) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ tailwind.Merge("flex flex-col gap-2 p-4 min-w-0 border-border", cellClass(cellStack(ctx), p), p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// withGridStack renders its children knowing the breakpoint of the grid
// they're in, which places their spans and borders.
func withGridStack(bp *gridBreakpoint) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		children := templ.GetChildren(ctx)
		ctx = context.WithValue(templ.ClearChildren(ctx), gridStackKey{}, bp)
		return children.Render(ctx, w)
	})
}

// cellStack returns the breakpoint of the grid a cell is in, as a grid's
// default for a cell outside one.
func cellStack(ctx context.Context) *gridBreakpoint {
	if bp, ok := ctx.Value(gridStackKey{}).(*gridBreakpoint); ok {
		return bp
	}
	return gridBreakpoints[props.GridStackMedium]
}
