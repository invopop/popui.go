package popui

import (
	"strconv"

	"github.com/invopop/popui.go/classes"
	"github.com/invopop/popui.go/props"
	"github.com/invopop/popui.go/tailwind"
)

// Tabs renders a self-contained tabbed view: an Alpine scope holding the active
// tab, a trigger row built from Tabs, then its children (one popui.Tab content
// panel per tab). See props.Tabs. All switching logic lives here — clicking a
// trigger both restyles the row and reveals the matching Tab panel. Omit the
// children for a stand-alone trigger row.
templ Tabs(p ...props.Tabs) {
	{{ prp := props.First(p) }}
	{{
		model := prp.Model
		if model == "" {
			model = "tab"
		}
		active := prp.Active
		if active == "" && len(prp.Tabs) > 0 {
			active = prp.Tabs[0].Value
		}
	}}
	<div
		if prp.ID != "" {
			id={ prp.ID }
		}
		x-data={ "{ " + model + ": '" + jsSingleQuoteEscape(active) + "' }" }
		class={ tailwind.Merge("flex flex-col", prp.Class) }
		{ prp.Attributes... }
	>
		// No margin below the row: each Tab panel pads its own content, so a
		// margin here would stack on top of it.
		<div
			role="tablist"
			class={ tailwind.Merge("inline-flex w-full", tabsClasses(prp.Variant, prp.Size)) }
		>
			for _, t := range prp.Tabs {
				if t.Href != "" {
					// A tab that's a page of its own: a link, drawn active
					// when it's the page being shown.
					<a
						href={ t.Href }
						role="tab"
						class={ tabTriggerClass(prp.Variant, t) }
						if t.Title != "" {
							title={ t.Title }
							aria-label={ t.Title }
						}
						data-state={ tabState(t.Value == active) }
						aria-selected={ strconv.FormatBool(t.Value == active) }
						if t.Value == active {
							aria-current="page"
						}
						{ t.Attributes... }
					>
						@tabTrigger(prp.Variant, t)
					</a>
				} else {
					// The state is drawn before Alpine starts, so the row
					// doesn't change as the page loads.
					<button
						type="button"
						role="tab"
						class={ tabTriggerClass(prp.Variant, t) }
						if t.Title != "" {
							title={ t.Title }
							aria-label={ t.Title }
						}
						data-state={ tabState(t.Value == active) }
						@click={ model + " = '" + jsSingleQuoteEscape(t.Value) + "'" }
						:data-state={ model + " === '" + jsSingleQuoteEscape(t.Value) + "' ? 'active' : 'inactive'" }
						:aria-selected={ model + " === '" + jsSingleQuoteEscape(t.Value) + "'" }
						{ t.Attributes... }
					>
						@tabTrigger(prp.Variant, t)
					</button>
				}
			}
		</div>
		{ children... }
	</div>
}

// tabTrigger is what a trigger shows: its icon, label and count.
templ tabTrigger(variant string, t props.TabItem) {
	if t.Icon != nil {
		@t.Icon
	}
	if t.Label != "" {
		<span class="truncate">{ t.Label }</span>
	}
	if t.Count > 0 {
		if variant == "pill" {
			<span class="inline-flex items-center justify-center rounded bg-background-default-tertiary px-1 text-sm tabular-nums shrink-0">{ strconv.Itoa(t.Count) }</span>
		} else {
			<span class={ "tabular-nums shrink-0", templ.KV("font-normal text-foreground-default-secondary", variant == tabsPrimary) }>({ strconv.Itoa(t.Count) })</span>
		}
	}
}

// Tab renders one tab's content panel inside a popui.Tabs, shown only while the
// view's Model equals Value. See props.Tab.
templ Tab(p ...props.Tab) {
	{{ prp := props.First(p) }}
	{{
		model := prp.Model
		if model == "" {
			model = "tab"
		}
	}}
	<div
		if prp.ID != "" {
			id={ prp.ID }
		}
		role="tabpanel"
		x-show={ model + " === '" + jsSingleQuoteEscape(prp.Value) + "'" }
		x-cloak
		class={ tailwind.Merge("py-2", prp.Class) }
		{ prp.Attributes... }
	>
		{ children... }
	</div>
}

// tabsPrimary is the variant for the tabs of a page.
const tabsPrimary = "primary"

func tabState(active bool) string {
	if active {
		return "active"
	}
	return "inactive"
}

func tabTriggerClass(variant string, t props.TabItem) string {
	return tailwind.Merge(
		// min-w-0 lets a trigger shrink inside the row so a long
		// label truncates instead of overflowing the container;
		// icon wrappers (divs) keep their size.
		"inline-flex items-center justify-center gap-1.5 whitespace-nowrap text-base cursor-pointer min-w-0 [&>div]:shrink-0",
		tabTriggerClasses(variant),
		// An icon-only pill is a square around its glyph, the
		// way the console's mode switch draws one.
		classes.If(variant == "pill" && t.Label == "", "p-1 w-auto"),
	)
}

func tabsClasses(variant, size string) string {
	if variant == tabsPrimary {
		// A row of cells along the top of the page's content, with a line
		// under it that the active tab opens.
		return tailwind.Merge(
			"items-stretch border-b border-border bg-background",
			classes.If(size != "lg", "h-10"),
			classes.If(size == "lg", "h-12"),
		)
	}
	return tailwind.Merge(
		classes.If(variant != "pill", "gap-6 overflow-visible border-b border-border"),
		classes.If(variant == "pill", "bg-background-default-tertiary text-base text-foreground h-7 items-center justify-center rounded-md p-0.5 gap-0.5"),
	)
}

func tabTriggerClasses(variant string) string {
	if variant == tabsPrimary {
		// The others are tinted cells with a line between them. The active
		// tab has the content's background and is a pixel taller, which
		// covers the row's line under it and joins it to the content.
		return "shrink-0 px-4 border-r border-border bg-background-default-secondary font-medium text-foreground hover:bg-background-default-tertiary data-[state=active]:bg-background data-[state=active]:-mb-px focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-border-selected-bold"
	}
	return tailwind.Merge(
		classes.If(variant != "pill", "relative text-foreground-default-secondary pb-2 data-[state=active]:text-foreground-selected data-[state=active]:font-medium data-[state=active]:border-b data-[state=active]:border-foreground-selected data-[state=active]:-bottom-px"),
		classes.If(variant == "pill", "rounded px-3 py-0.5 font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 w-full data-[state=active]:bg-background data-[state=active]:shadow-sm data-[state=inactive]:text-foreground-default-secondary"),
	)
}
