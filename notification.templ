package popui

import (
	"github.com/invopop/icons"
	"github.com/invopop/popui.go/classes"
	"github.com/invopop/popui.go/props"
	"github.com/invopop/popui.go/tailwind"
)

// Notification provides a wrapper for a text to be shown as feedback.
// Valid types are: info, warning, error, success, neutral
templ Notification(opts ...props.Notification) {
	{{ p := props.First(opts) }}
	// Without a text there is no heading line: the description becomes the
	// main message and shares a single row with the actions, so the icon and
	// the row center on each other instead of hanging from the top.
	{{ titleless := p.Text == "" && (p.Description != "" || p.Actions != nil) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			tailwind.Merge(
				"flex px-3 py-2 justify-start items-start gap-1.5 rounded-xl text-base mb-4",
				classes.If(titleless, "items-center"),
				notificationClasses(p.Type),
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		if p.Type != "" {
			<div
				class={
					tailwind.Merge(
						classes.If(!titleless, "mt-0.5"),
						// The neutral surface is plain, so the icon mutes
						// instead of inheriting the foreground text color.
						classes.If(p.Type == "neutral", "text-foreground-default-secondary"),
					),
				}
			>
				if p.Type == "error" {
					@icons.Failure()
				} else if p.Type == "warning" {
					@icons.Alert()
				} else if p.Type == "success" {
					@icons.Success()
				} else {
					@icons.InfoBold()
				}
			</div>
		}
		// min-w-0 + break-words wrap long messages — including unbroken
		// tokens — inside the rounded box. flex-1 lets the actions sit
		// against the right edge of the notification.
		<div class="flex-1 min-w-0 break-words">
			if p.Text != "" || p.Description != "" || p.Actions != nil {
				if p.Text != "" {
					<p class="font-medium">{ p.Text }</p>
				}
				// The description and the actions share a row below the
				// text, which spans the full width on its own. The
				// description paragraph stays even when empty so that
				// justify-between still pushes the actions to the right.
				// items-start keeps the buttons at the top of the row, so
				// they stay put as the description wraps onto more lines.
				<div class={ tailwind.Merge("flex items-start justify-between gap-3", classes.If(titleless, "items-center")) }>
					<p
						class={
							tailwind.Merge(
								"min-w-0 text-foreground-default-secondary text-sm",
								// As the only text, the description reads as
								// the main message rather than as a muted
								// subline.
								classes.If(titleless, "text-base text-inherit"),
							),
						}
					>{ p.Description }</p>
					if p.Actions != nil {
						<div class="flex shrink-0 items-center gap-2">
							@p.Actions
						</div>
					}
				</div>
			} else {
				{ children... }
			}
		</div>
	</div>
}

func notificationClasses(notifType string) string {
	return tailwind.Merge(
		classes.If(notifType == "info", "bg-background-info text-foreground-info"),
		classes.If(notifType == "warning", "bg-background-warning text-foreground-warning"),
		classes.If(notifType == "error", "bg-background-critical text-foreground-critical"),
		classes.If(notifType == "success", "bg-background-success text-foreground-success"),
		classes.If(notifType == "neutral", "bg-background border border-border text-foreground"),
	)
}
