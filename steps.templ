package popui

import (
	"github.com/invopop/popui.go/props"
	"github.com/invopop/popui.go/tailwind"
)

// Steps shows where the user is in a flow of several pages, such as a
// wizard, as a timeline of Step children, numbered in order. With the
// "horizontal" Orientation it is a bar of the steps' markers alone, and
// with "responsive" it is the timeline on wide screens and the bar on
// narrow ones.
templ Steps(opts ...props.Steps) {
	{{ p := props.First(opts) }}
	<ol
		if p.ID != "" {
			id={ p.ID }
		}
		if p.Label != "" {
			aria-label={ p.Label }
		}
		if p.Orientation != "" && p.Orientation != props.StepsOrientationVertical {
			data-orientation={ p.Orientation }
		}
		class={ tailwind.Merge("popui-steps", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</ol>
}

// Step is one step of Steps: a marker with its number, or a tick once
// the step is completed, and a label. SubStep children are the parts of
// the step, shown under it.
templ Step(opts ...props.Step) {
	{{ p := props.First(opts) }}
	<li
		if p.ID != "" {
			id={ p.ID }
		}
		if p.Status == props.StepStatusCurrent || p.Status == props.StepStatusCompleted {
			data-status={ p.Status }
		}
		if p.Status == props.StepStatusCurrent {
			aria-current="step"
		}
		class={ tailwind.Merge("popui-step", p.Class) }
		{ p.Attributes... }
	>
		<div class="popui-step-row">
			<span class="popui-step-marker" aria-hidden="true">
				if p.Status == props.StepStatusCompleted {
					@stepTick()
				}
			</span>
			<span class="popui-step-label">{ p.Label }</span>
		</div>
		<ol class="popui-substeps">{ children... }</ol>
	</li>
}

// SubStep is one part of a Step, branching off the timeline under it.
templ SubStep(opts ...props.SubStep) {
	{{ p := props.First(opts) }}
	<li
		if p.ID != "" {
			id={ p.ID }
		}
		if p.Current {
			data-current
			aria-current="step"
		}
		class={ tailwind.Merge("popui-substep", p.Class) }
		{ p.Attributes... }
	>
		{ p.Label }
	</li>
}

// stepTick is the tick of a completed step's marker, drawn for its 20px
// box with a thinner line than the icon set's.
templ stepTick() {
	<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
		<path d="M15 5.10526L8.33333 14.5789L5 11.1839" stroke="currentColor" stroke-width="1.3"></path>
	</svg>
}
