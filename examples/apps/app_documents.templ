package apps

import (
	"github.com/invopop/icons"
	"github.com/invopop/popui.go"
	"github.com/invopop/popui.go/flash"
	"github.com/invopop/popui.go/props"
)

// appDocumentFormID lets the header Save button submit the workflow form via
// the HTML form= attribute.
const appDocumentFormID = "app-document-form"

// AppDocuments lists the example documents published in the app's docs: one
// titled section per channel, and inside it one reorderable deck per schema.
templ AppDocuments(org *Org, app *Application, dc *DocumentCollection, err error) {
	@appsLayout(org) {
		@popui.Header(props.Header{
			Breadcrumbs: []props.Breadcrumb{
				{
					Label:      "Applications",
					Href:       templ.SafeURL(baseURL(org, "apps")),
					Attributes: navAttrs(baseURL(org, "apps")),
				},
				{Label: app.Name},
			},
		}) {
			{{ fm := flash.GetMessage(ctx) }}
			if fm != nil {
				@popui.Notification(props.Notification{Type: fm.Type, Text: fm.Text})
			}
			@popui.Button(props.Button{
				Variant:    "primary",
				Attributes: navAttrs(baseURL(org, "apps", app.ID, "documents", "new")),
			}) {
				@icons.Add()
				New document
			}
		}
		@popui.Main(props.Main{Center: true, Class: mainClass}) {
			@popui.Article(props.Article{
				Title:              app.Name,
				HideTitleSeparator: true,
			}) {
				@appTabs(org, ApplicationModelToForm(app), "documents")
				if err != nil {
					@popui.InputError(props.Error{Text: err.Error()})
				}
				if dc.Count() == 0 {
					@popui.Info() {
						No documents yet. Create one and it will appear under its channel and schema.
					}
				}
				// Named channels in the app's order, then the default channel.
				for _, ch := range app.Channels {
					@documentChannelSection(org, app, ch.Key, ch.Label, dc.ForChannel(ch.Key))
				}
				@documentChannelSection(org, app, "", "Default channel", dc.ForChannel(""))
			}
		}
	}
}

// documentChannelSection is the titled block for one channel; it is skipped
// when the channel has no documents so the page shows only what exists.
templ documentChannelSection(org *Org, app *Application, channel, label string, groups []*DocumentGroup) {
	if len(groups) > 0 {
		<div class="w-full flex flex-col gap-3">
			@popui.Separator()
			@popui.TitleGroup(props.TitleGroup{
				Title:      label,
				Horizontal: true,
			})
			for _, g := range groups {
				@documentDeck(org, app, g)
			}
		</div>
	}
}

// documentDeck is one reorderable deck: the documents of a channel that share
// a schema. Reorder mode is entered from the kebab menu and left with the
// Done button; each move posts the order without swapping.
templ documentDeck(org *Org, app *Application, g *DocumentGroup) {
	{{
		channelSeg := g.Channel
		if channelSeg == "" {
			channelSeg = "default"
		}
		addURL := baseURL(org, "apps", app.ID, "documents", "new") + "?channel=" + g.Channel + "&schema=" + g.Schema
	}}
	// hx-disinherit keeps the form's trigger and swap="none" off the cards,
	// which carry their own hx-get and would otherwise never navigate.
	<form
		hx-post={ baseURL(org, "apps", app.ID, "documents", "groups", channelSeg, slugify(g.Schema), "reorder") }
		hx-trigger="popui-card-deck-reorder"
		hx-swap="none"
		hx-disinherit="*"
		class="w-full"
	>
		@popui.CardDeck(props.CardDeck{Reorderable: true, Name: "order"}) {
			@popui.CardDeckHead() {
				<span class="flex items-center gap-2 min-w-0">
					<span class="text-foreground text-base font-medium truncate">{ schemaLabel(g.Schema, "documents") }</span>
					<code class="text-sm text-foreground-default-tertiary">{ g.Schema }</code>
				</span>
				<div class="flex items-center gap-1 shrink-0">
					@popui.Button(props.Button{Size: props.ButtonSizeSmall, Attributes: navAttrs(addURL)}) {
						@icons.Add()
						Add
					}
					@popui.CardDeckReorderButton(props.CardDeckReorderButton{
						Attributes: templ.Attributes{"x-show": "reordering", "x-cloak": ""},
					})
					if len(g.Documents) > 1 {
						@popui.Menu(props.Menu{RightAlign: true}) {
							@popui.MenuItem(props.MenuItem{Attributes: templ.Attributes{
								"@click": "toggleReorder(); $el.closest('[popover]').hidePopover()",
							}}) {
								@icons.Drag()
								<span>Reorder</span>
							}
						}
					}
				</div>
			}
			for _, doc := range g.Documents {
				@documentCard(org, app, doc)
			}
		}
	</form>
	for _, doc := range g.Documents {
		@deleteDocumentPopover(org, app, doc)
	}
}

templ documentCard(org *Org, app *Application, doc *Document) {
	{{
		attrs := navAttrs(baseURL(org, "apps", app.ID, "documents", doc.ID))
		attrs["data-card-id"] = doc.ID
	}}
	@popui.Card(props.Card{
		Class:      "flex-row items-center gap-3 p-3 cursor-pointer hover:bg-background-default-secondary",
		Attributes: attrs,
	}) {
		<span class="grow min-w-0 text-base font-medium text-foreground truncate">{ doc.Title }</span>
		<div class="flex items-center gap-2 shrink-0">
			// Stop the click so the row's hx-get does not fire when using the menu.
			<div @click.stop>
				@popui.Menu(props.Menu{RightAlign: true}) {
					@popui.MenuItem(props.MenuItem{Attributes: navAttrs(baseURL(org, "apps", app.ID, "documents", doc.ID))}) {
						@icons.Edit()
						<span>Edit</span>
					}
					@popui.MenuItem(props.MenuItem{Variant: props.MenuItemVariantDanger, Attributes: templ.Attributes{
						"@click": props.ShowPopover("delete-document-"+doc.ID) + "; $el.closest('[popover]').hidePopover()",
					}}) {
						@icons.Delete()
						<span>Delete</span>
					}
				}
			</div>
		</div>
	}
}

// deleteDocumentPopover asks for confirmation before a document is removed.
templ deleteDocumentPopover(org *Org, app *Application, doc *Document) {
	{{ id := "delete-document-" + doc.ID }}
	@popui.Popover(props.Popover{ID: id, Backdrop: true, Class: "w-[28rem] max-w-full"}) {
		<form class="flex flex-col gap-4" hx-post={ baseURL(org, "apps", app.ID, "documents", doc.ID, "delete") } hx-target={ popui.AppTarget }>
			@popui.Title() {
				Delete document
			}
			@popui.P() {
				This removes <strong>{ doc.Title }</strong> from the documentation. This cannot be undone.
			}
			@popui.ButtonGroup(props.ButtonGroup{Align: "right"}) {
				@popui.Button(props.Button{
					Size:                props.ButtonSizeLarge,
					Variant:             "secondary",
					Type:                "button",
					PopoverTarget:       id,
					PopoverTargetAction: "hide",
				}) {
					Cancel
				}
				@popui.Button(props.Button{Size: props.ButtonSizeLarge, Variant: "danger", Type: "submit"}) {
					Delete document
				}
			}
		</form>
	}
}

// AppDocumentEdit is the editor for one example document.
templ AppDocumentEdit(org *Org, app *Application, form *DocumentForm, err error) {
	@appsLayout(org) {
		{{
			title := form.Title
			if title == "" {
				title = "New document"
			}
		}}
		@popui.Header(props.Header{
			Breadcrumbs: []props.Breadcrumb{
				{
					Label:      "Applications",
					Href:       templ.SafeURL(baseURL(org, "apps")),
					Attributes: navAttrs(baseURL(org, "apps")),
				},
				{
					Label:      app.Name,
					Href:       templ.SafeURL(baseURL(org, "apps", app.ID, "documents")),
					Attributes: navAttrs(baseURL(org, "apps", app.ID, "documents")),
				},
				{Label: title},
			},
		}) {
			{{ fm := flash.GetMessage(ctx) }}
			if fm != nil {
				@popui.Notification(props.Notification{Type: fm.Type, Text: fm.Text})
			}
			@popui.Button(props.Button{
				ID:      "apps-document-save",
				Type:    "submit",
				Variant: "primary",
				Form:    appDocumentFormID,
			}) {
				Save
			}
		}
		@popui.Main(props.Main{Center: true, Class: mainClass}) {
			@popui.Article(props.Article{
				Title:       "Example document",
				Description: "A GOBL document readers can copy into the GOBL builder to preview and verify.",
			}) {
				<form id={ appDocumentFormID } class="flex flex-col gap-4" hx-post={ baseURL(org, "apps", app.ID, "documents") } hx-target={ popui.AppTarget } hx-indicator="#apps-document-save">
					<input type="hidden" name="id" value={ form.ID }/>
					@popui.Fieldset() {
						if err != nil {
							@popui.InputError(props.Error{Text: err.Error()})
						}
						@popui.Fieldset(props.Fieldset{Variant: props.FieldsetVariantCard}) {
							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div class="md:col-span-2">
									@popui.Input(props.Input{
										Label:       "Title",
										Name:        "title",
										Value:       form.Title,
										Required:    true,
										Placeholder: "e.g. B2B Standard Invoice",
										Tooltip: props.Tooltip{
											Delay:       tooltipDelay,
											Title:       "Title",
											Description: "Shown as the accordion heading in the docs. Name the business case, not the file.",
										},
									})
								</div>
								@popui.Select(props.Select{
									Label: "Channel",
									Name:  "channel",
									Tooltip: props.Tooltip{
										Delay:       tooltipDelay,
										Title:       "Channel",
										Description: "Tags the example with the app channel it targets, so readers can tell SII from TicketBAI at a glance.",
									},
								}) {
									<option value="" selected?={ form.Channel == "" }>Default</option>
									for _, ch := range app.Channels {
										<option value={ ch.Key } selected?={ form.Channel == ch.Key }>{ ch.Label }</option>
									}
								}
								@popui.Select(props.Select{
									Label: "Schema",
									Name:  "schema",
									Tooltip: props.Tooltip{
										Delay:       tooltipDelay,
										Title:       "Schema",
										Description: "The GOBL schema of the example document.",
									},
								}) {
									for _, schema := range append([]string{"org/party"}, actionSchemas...) {
										<option value={ schema } selected?={ form.Schema == schema }>{ schema }</option>
									}
								}
							</div>
							@popui.Textarea(props.Textarea{
								Label:       "Description (optional)",
								Name:        "description",
								Value:       form.Description,
								Rows:        3,
								Placeholder: "When to use this document and what makes it different",
							})
						}
						<div class="w-full flex flex-col gap-3">
							@popui.Separator()
							@popui.TitleGroup(props.TitleGroup{
								Title:       "Content",
								Description: "Minimal GOBL JSON; totals and derived fields are calculated when it is built",
								Horizontal:  true,
							})
							@popui.Fieldset(props.Fieldset{Variant: props.FieldsetVariantCard}) {
								@popui.Textarea(props.Textarea{
									Name:        "content",
									Value:       form.Content,
									Rows:        18,
									Monospace:   true,
									Placeholder: `{ "$schema": "https://gobl.org/draft-0/bill/invoice", ... }`,
								})
							}
						</div>
					}
				</form>
			}
		}
	}
}
