package popui

import (
	"encoding/json"
	"time"

	"github.com/invopop/icons"
	"github.com/invopop/popui.go/period"
	"github.com/invopop/popui.go/props"
	"github.com/invopop/popui.go/tailwind"
)

// Period renders a picker for the window of time a list or report shows:
// a button naming the period, which opens a panel of rolling periods
// ("Last 30 days") beside tabs of days, weeks, months, quarters and years,
// and arrows to step to the window after or before. Windows run newest
// first, as lists do: the latest at the top left, and the left arrow
// steps later. Clicking a window
// picks it; dragging across windows, or shift-clicking one, picks the run
// between. See props.Period for the field reference, and the period
// package to read the value on the server.
//
// Backed by the `periodSelect` Alpine controller in popui.js.
templ Period(opts ...props.Period) {
	{{ p := periodProps(props.First(opts)) }}
	{{ cur, err := period.Parse(p.Value) }}
	{{
		if err != nil {
			cur, _ = period.Parse(p.Default)
		}
	}}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		x-data={ periodData(p, cur) }
		@keydown.escape="close()"
		class={ tailwind.Merge("popui-period relative inline-flex items-center gap-1", p.Class) }
		{ p.Attributes... }
	>
		<input
			type="hidden"
			name={ p.Name }
			value={ cur.String() }
			if cur.String() == p.Default {
				disabled
			}
			x-ref="input"
			:value="value"
			:disabled="value === def"
		/>
		// Periods run newest first, as lists do: left steps later, up to now, and
		// right earlier.
		@Button(props.Button{
			Size: props.ButtonSizeIcon,
			Attributes: templ.Attributes{
				"type":       "button",
				"aria-label": "Later period",
				"title":      "Later period",
				":disabled":  "disabled || !canShift(1)",
				"@click":     "shift(1)",
			},
		}) {
			@icons.ChevronLeft()
		}
		@Button(props.Button{
			Attributes: templ.Attributes{
				"type":          "button",
				"x-ref":         "trigger",
				"aria-haspopup": "dialog",
				":aria-expanded": "open",
				":title":        "dates(value)",
				":disabled":     "disabled",
				"@click":        "toggle()",
			},
			Disabled: p.Disabled,
		}) {
			@icons.Calendar()
			<span x-text="label(value)" class="whitespace-nowrap">{ cur.Label() }</span>
			@icons.ChevronDown()
		}
		@Button(props.Button{
			Size: props.ButtonSizeIcon,
			Attributes: templ.Attributes{
				"type":       "button",
				"aria-label": "Earlier period",
				"title":      "Earlier period",
				":disabled":  "disabled || !canShift(-1)",
				"@click":     "shift(-1)",
			},
		}) {
			@icons.ChevronRight()
		}
		<div
			x-show="open"
			x-cloak
			x-transition.opacity.duration.100ms
			@click.outside="close()"
			:style="end ? { left: 'auto', right: 0 } : { left: 0, right: 'auto' }"
			role="dialog"
			aria-label="Period"
			class="popui-period-panel context-menu absolute top-full z-50 mt-1 flex border border-border rounded-xl bg-background shadow-lg overflow-hidden"
		>
			<div class="flex flex-col gap-0.5 p-2 border-r border-border">
				<template x-for="n in rolling" :key="n">
					<button
						type="button"
						class="popui-cal-preset"
						:data-active="value === n + 'd'"
						:data-label="label(n + 'd')"
						x-text="label(n + 'd')"
						@click="pick(n + 'd')"
					></button>
				</template>
				if !p.NoAll {
					<button
						type="button"
						class="popui-cal-preset"
						data-label="All time"
						:data-active="value === 'all'"
						@click="pick('all')"
					>All time</button>
				}
			</div>
			<div class="flex flex-col gap-3 p-3 w-[300px]">
				<div class="popui-period-units" role="tablist">
					<template x-for="u in units" :key="u.key">
						<button
							type="button"
							role="tab"
							class="popui-period-unit"
							:aria-selected="unit === u.key"
							x-text="u.label"
							@click="setUnit(u.key)"
						></button>
					</template>
				</div>
				<div class="flex items-center justify-between">
					@Button(props.Button{
						Size:    props.ButtonSizeIconSmall,
						Variant: props.ButtonVariantTransparent,
						Attributes: templ.Attributes{
							"type":       "button",
							"aria-label": "Later",
							":disabled":  "!canTurn(1)",
							"@click":     "turn(1)",
						},
					}) {
						@icons.ChevronLeft()
					}
					<span class="text-sm font-medium text-foreground" x-text="pageTitle()"></span>
					@Button(props.Button{
						Size:    props.ButtonSizeIconSmall,
						Variant: props.ButtonVariantTransparent,
						Attributes: templ.Attributes{
							"type":       "button",
							"aria-label": "Earlier",
							"@click":     "turn(-1)",
						},
					}) {
						@icons.ChevronRight()
					}
				</div>
				<div
					class="popui-period-grid"
					:style="{ 'grid-template-columns': cols() }"
					@pointerleave="hover = null"
				>
					<template x-for="c in cells()" :key="c.id">
						<span class="contents">
							<span x-show="c.kind !== 'tile'" class="popui-period-head" x-text="c.label"></span>
							<button
								x-show="c.kind === 'tile'"
								type="button"
								class="popui-period-tile"
								:disabled="c.future"
								:data-state="state(c.n)"
								:data-current="c.current"
								:title="c.title"
								:aria-label="c.title"
								x-text="c.label"
								@click="key(c.n, $event)"
								@pointerdown.prevent="press(c.n, $event)"
								@pointerenter="enter(c.n)"
							></button>
						</span>
					</template>
				</div>
				<div class="flex items-center justify-between gap-3 pt-2 border-t border-border text-xs">
					<span class="text-foreground-default-secondary truncate" x-text="footer()"></span>
					<span class="text-foreground-default-tertiary whitespace-nowrap">Drag or shift-click for a range</span>
				</div>
			</div>
		</div>
	</div>
}

func periodProps(p props.Period) props.Period {
	if p.Name == "" {
		p.Name = "period"
	}
	if p.Default == "" {
		p.Default = period.Default
	}
	if p.Value == "" {
		p.Value = p.Default
	}
	if p.Today.IsZero() {
		p.Today = time.Now()
	}
	if len(p.Rolling) == 0 {
		p.Rolling = []int{7, 30, 90, 365}
	}
	return p
}

// periodData builds the x-data="periodSelect({...})" snippet.
func periodData(p props.Period, cur period.Period) string {
	data, _ := json.Marshal(map[string]any{
		"value":    cur.String(),
		"default":  p.Default,
		"today":    p.Today.Format(time.DateOnly),
		"rolling":  p.Rolling,
		"disabled": p.Disabled,
	})
	return "periodSelect(" + string(data) + ")"
}
